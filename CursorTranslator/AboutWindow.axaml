<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CursorTranslator.AboutWindow"
        Title="关于 Cheems翻译"
        Width="540" Height="500" MinWidth="540" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        CanResize="False" ShowInTaskbar="False" SystemDecorations="None"
        Background="Transparent" TransparencyLevelHint="Transparent"
        Foreground="#302B27">
  <Window.Styles>
    <Style Selector="Button">
      <Setter Property="Background" Value="#F7F1EB" />
      <Setter Property="Foreground" Value="#684B3C" />
      <Setter Property="BorderBrush" Value="#E7D8CA" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button:pointerover">
      <Setter Property="Background" Value="#F0E5DA" />
      <Setter Property="BorderBrush" Value="#D9C6B5" />
    </Style>
    <Style Selector="Button:pressed">
      <Setter Property="Background" Value="#E9DACE" />
      <Setter Property="BorderBrush" Value="#D2BBA9" />
    </Style>
    <Style Selector="Button.social-link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="6,8" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style Selector="Button.social-link:pointerover">
      <Setter Property="Background" Value="#F5EEE6" />
      <Setter Property="BorderBrush" Value="#F5EEE6" />
    </Style>
    <Style Selector="Button.social-link:pressed">
      <Setter Property="Background" Value="#EEE2D6" />
      <Setter Property="BorderBrush" Value="#EEE2D6" />
    </Style>
    <Style Selector="Ellipse.qq-ripple">
      <Style.Animations>
        <Animation Duration="0:0:2.4" IterationCount="INFINITE">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="ScaleTransform.ScaleX" Value="1" />
            <Setter Property="ScaleTransform.ScaleY" Value="1" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="ScaleTransform.ScaleX" Value="1.35" />
            <Setter Property="ScaleTransform.ScaleY" Value="1.35" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Ellipse.qq-ripple-delayed">
      <Style.Animations>
        <Animation Duration="0:0:2.4" Delay="0:0:1.2" IterationCount="INFINITE">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="ScaleTransform.ScaleX" Value="1" />
            <Setter Property="ScaleTransform.ScaleY" Value="1" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="ScaleTransform.ScaleX" Value="1.35" />
            <Setter Property="ScaleTransform.ScaleY" Value="1.35" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Button.window-control">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#655A52" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="30" />
      <Setter Property="MinWidth" Value="36" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.window-control:pointerover">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Opacity" Value="0.68" />
    </Style>
    <Style Selector="Button.window-control:pressed">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Opacity" Value="0.42" />
    </Style>
  </Window.Styles>

  <Border Margin="8" CornerRadius="14" Background="#FAF8F5" BorderBrush="#DCD2C8"
          BorderThickness="1" ClipToBounds="True" PointerPressed="Surface_PointerPressed">
    <Grid RowDefinitions="40,*">
      <Grid ColumnDefinitions="*,Auto" Margin="10,2,8,0">
        <TextBlock Text="关于" FontSize="13" Foreground="#756B63" VerticalAlignment="Center" />
        <Button Grid.Column="1" Classes="window-control" ToolTip.Tip="关闭"
                Click="Close_Click">
          <Path Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center"
                VerticalAlignment="Center" Fill="#655A52"
                Data="M259.008 797.44a32 32 0 0 1-22.656-54.592l505.856-505.856a32 32 0 0 1 45.248 45.248L281.6 788.032a31.68 31.68 0 0 1-22.592 9.408z M764.864 797.44a32.128 32.128 0 0 1-22.656-9.344L236.352 282.176a32 32 0 0 1 45.248-45.248l505.856 505.856a32 32 0 0 1-22.592 54.656z" />
        </Button>
      </Grid>

      <StackPanel Grid.Row="1" Margin="24,12,24,20" Spacing="16">
        <StackPanel Spacing="4">
          <TextBlock Text="Cheems翻译" FontSize="23" FontWeight="Bold" />
          <TextBlock Text="开发者信息" FontSize="13" Foreground="#756B63" />
        </StackPanel>

        <Border Padding="15,12" CornerRadius="11" Background="#FFFEFC"
                BorderBrush="#EAE2D9" BorderThickness="1">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Ellipse Width="42" Height="42" VerticalAlignment="Center">
              <Ellipse.Fill>
                <ImageBrush Source="/Assets/head_portrait.png" Stretch="UniformToFill" />
              </Ellipse.Fill>
            </Ellipse>
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
              <TextBlock Text="开发者名字" FontSize="12" Foreground="#756B63" />
              <TextBlock Text="萤灬虫" FontSize="16" FontWeight="SemiBold" />
            </StackPanel>
          </Grid>
        </Border>

        <StackPanel Spacing="8">
          <TextBlock Text="主页与社区" FontSize="14" FontWeight="SemiBold" />
          <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="4">
            <Button Classes="social-link" Tag="https://cheems.cn" ToolTip.Tip="打开个人主页"
                    Click="OpenLink_Click">
              <StackPanel Width="88" Spacing="7" HorizontalAlignment="Center">
                <Ellipse Width="48" Height="48" HorizontalAlignment="Center">
                  <Ellipse.Fill>
                    <ImageBrush Source="/Assets/head_portrait.png" Stretch="UniformToFill" />
                  </Ellipse.Fill>
                </Ellipse>
                <TextBlock Text="个人主页" FontSize="12" Foreground="#493F38"
                           HorizontalAlignment="Center" />
              </StackPanel>
            </Button>

            <Button Grid.Column="1" Classes="social-link" Tag="https://github.com/firebugbugs"
                    ToolTip.Tip="打开 GitHub" Click="OpenLink_Click">
              <StackPanel Width="88" Spacing="7" HorizontalAlignment="Center">
                <Border Width="48" Height="48" CornerRadius="24" Background="#F7F1EB"
                        HorizontalAlignment="Center">
                  <Path Width="27" Height="27" Stretch="Uniform" Fill="#444444"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Data="M512 12.64c-282.752 0-512 229.216-512 512 0 226.208 146.72 418.144 350.144 485.824 25.6 4.736 35.008-11.104 35.008-24.64 0-12.192-0.48-52.544-0.704-95.328-142.464 30.976-172.512-60.416-172.512-60.416-23.296-59.168-56.832-74.912-56.832-74.912-46.464-31.776 3.52-31.136 3.52-31.136 51.392 3.616 78.464 52.768 78.464 52.768 45.664 78.272 119.776 55.648 148.992 42.56 4.576-33.088 17.856-55.68 32.512-68.48-113.728-12.928-233.28-56.864-233.28-253.024 0-55.904 20-101.568 52.768-137.44-5.312-12.896-22.848-64.96 4.96-135.488 0 0 43.008-13.76 140.832 52.48 40.832-11.36 84.64-17.024 128.16-17.248 43.488 0.192 87.328 5.888 128.256 17.248 97.728-66.24 140.64-52.48 140.64-52.48 27.872 70.528 10.336 122.592 5.024 135.488 32.832 35.84 52.704 81.536 52.704 137.44 0 196.64-119.776 239.936-233.792 252.64 18.368 15.904 34.72 47.04 34.72 94.816 0 68.512-0.608 123.648-0.608 140.512 0 13.632 9.216 29.6 35.168 24.576 203.328-67.776 349.856-259.616 349.856-485.76 0-282.784-229.248-512-512-512z" />
                </Border>
                <TextBlock Text="GitHub" FontSize="12" Foreground="#493F38"
                           HorizontalAlignment="Center" />
              </StackPanel>
            </Button>

            <Button Grid.Column="2" Classes="social-link" Tag="https://gitee.com/unbengable"
                    ToolTip.Tip="打开 Gitee" Click="OpenLink_Click">
              <StackPanel Width="88" Spacing="7" HorizontalAlignment="Center">
                <Border Width="48" Height="48" CornerRadius="24" Background="#F7F1EB"
                        HorizontalAlignment="Center">
                  <Path Width="27" Height="27" Stretch="Uniform" Fill="#C71D23"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Data="M512 1024C229.2224 1024 0 794.7776 0 512S229.2224 0 512 0s512 229.2224 512 512-229.2224 512-512 512z m259.1488-568.8832H480.4096a25.2928 25.2928 0 0 0-25.2928 25.2928l-0.0256 63.2064c0 13.952 11.3152 25.2928 25.2672 25.2928h177.024c13.9776 0 25.2928 11.3152 25.2928 25.2672v12.6464a75.8528 75.8528 0 0 1-75.8528 75.8528H366.592a25.2928 25.2928 0 0 1-25.2672-25.2928v-240.1792a75.8528 75.8528 0 0 1 75.8272-75.8528h353.9456a25.2928 25.2928 0 0 0 25.2672-25.2928l0.0768-63.2064a25.2928 25.2928 0 0 0-25.2672-25.2928H417.152a189.6192 189.6192 0 0 0-189.6192 189.6448v353.9456c0 13.9776 11.3152 25.2928 25.2928 25.2928h372.9408a170.6496 170.6496 0 0 0 170.6496-170.6496v-145.408a25.2928 25.2928 0 0 0-25.2928-25.2672z" />
                </Border>
                <TextBlock Text="Gitee" FontSize="12" Foreground="#493F38"
                           HorizontalAlignment="Center" />
              </StackPanel>
            </Button>

            <Button Grid.Column="3" Classes="social-link"
                    Tag="https://space.bilibili.com/43096314" ToolTip.Tip="打开 B 站主页"
                    Click="OpenLink_Click">
              <StackPanel Width="88" Spacing="7" HorizontalAlignment="Center">
                <Border Width="48" Height="48" CornerRadius="24" Background="#F7F1EB"
                        HorizontalAlignment="Center">
                  <Viewbox Width="27" Height="27" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Stretch="Uniform">
                    <Canvas Width="1024" Height="1024">
                      <Path Stretch="None" Fill="#53D4F4"
                            Data="M769.856 348.928H261.248a27.84 27.84 0 0 0-28.48 27.584v337.152a27.712 27.712 0 0 0 28.48 27.456h508.608a26.496 26.496 0 0 0 27.072-27.456V376.512a26.688 26.688 0 0 0-27.072-27.584zM295.872 473.536l143.36-27.456 10.816 53.76-141.888 27.456zM516.8 637.44c-44.032 48-90.24-15.168-90.24-15.168l23.488-15.168s31.424 56.704 66.432-18.432c33.6 72.96 70.784 19.2 70.784 19.2l21.312 13.696s-39.68 63.872-91.712 15.872z m212.672-110.144L587.2 499.84l11.2-53.824 142.976 27.456z" />
                      <Path Stretch="None" Fill="#53D4F4"
                            Data="M512 0a512 512 0 1 0 512 512 512 512 0 0 0-512-512z m269.632 809.408a462.4 462.4 0 0 0-47.872 0s-2.624 41.088-37.696 41.792a39.552 39.552 0 0 1-41.792-39.552c-21.44 0-279.552 1.152-279.552 1.152s-4.544 38.08-39.552 38.08a39.68 39.68 0 0 1-39.552-38.08c-22.976 0-53.888-0.768-53.888-0.768a123.52 123.52 0 0 1-87.808-117.184c1.152-100.992 0-300.8 0-300.8a117.376 117.376 0 0 1 85.504-119.808 5388.8 5388.8 0 0 1 161.984-1.536l-65.92-64s-10.176-12.8 7.168-27.136 18.432-8.512 24.512-4.352 98.304 95.104 98.304 95.104h-12.416c35.392 0 71.936 0.576 107.008 0.576 13.568-13.568 90.816-89.216 96-92.928s7.168-10.112 24.512 4.16 7.168 27.136 7.168 27.136l-64.448 62.144c88.512 0.768 156.736 1.152 156.736 1.152a120.896 120.896 0 0 1 89.6 119.424c-1.152 100.224 0.384 301.76 0.384 301.76s-4.864 97.92-88.512 113.408z" />
                    </Canvas>
                  </Viewbox>
                </Border>
                <TextBlock Text="B 站" FontSize="12" Foreground="#493F38"
                           HorizontalAlignment="Center" />
              </StackPanel>
            </Button>

            <Button Grid.Column="4" Classes="social-link"
                    Tag="https://qm.qq.com/q/VdUX0gnh86" ToolTip.Tip="打开 QQ 加群邀请"
                    Click="OpenLink_Click">
              <StackPanel Width="88" Spacing="7" HorizontalAlignment="Center">
                <Grid Width="64" Height="64" Margin="0,-8,0,-8"
                      HorizontalAlignment="Center">
                  <Ellipse Classes="qq-ripple" Width="46" Height="46"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Stroke="#D9903D" StrokeThickness="2" Opacity="0"
                           RenderTransformOrigin="50%,50%">
                    <Ellipse.RenderTransform>
                      <ScaleTransform ScaleX="1" ScaleY="1" />
                    </Ellipse.RenderTransform>
                  </Ellipse>
                  <Ellipse Classes="qq-ripple-delayed" Width="46" Height="46"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Stroke="#D9903D" StrokeThickness="2" Opacity="0"
                           RenderTransformOrigin="50%,50%">
                    <Ellipse.RenderTransform>
                      <ScaleTransform ScaleX="1" ScaleY="1" />
                    </Ellipse.RenderTransform>
                  </Ellipse>
                  <Border Width="48" Height="48" CornerRadius="24" Background="#EAF4FF"
                          HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Viewbox Width="44" Height="44" Stretch="Uniform">
                      <Canvas Width="1024" Height="1024">
                      <Path Stretch="None" Fill="#FAAD08"
                            Data="M511.09761 957.257c-80.159 0-153.737-25.019-201.11-62.386-24.057 6.702-54.831 17.489-74.252 30.864-16.617 11.439-14.546 23.106-11.55 27.816 13.15 20.689 225.583 13.211 286.912 6.767v-3.061z" />
                      <Path Stretch="None" Fill="#FAAD08"
                            Data="M496.65061 957.257c80.157 0 153.737-25.019 201.11-62.386 24.057 6.702 54.83 17.489 74.253 30.864 16.616 11.439 14.543 23.106 11.55 27.816-13.15 20.689-225.584 13.211-286.914 6.767v-3.061z" />
                      <Path Stretch="None" Fill="#000000"
                            Data="M497.12861 474.524c131.934-0.876 237.669-25.783 273.497-35.34 8.541-2.28 13.11-6.364 13.11-6.364 0.03-1.172 0.542-20.952 0.542-31.155C784.27761 229.833 701.12561 57.173 496.64061 57.162 292.15661 57.173 209.00061 229.832 209.00061 401.665c0 10.203 0.516 29.983 0.547 31.155 0 0 3.717 3.821 10.529 5.67 33.078 8.98 140.803 35.139 276.08 36.034h0.972z" />
                      <Path Stretch="None" Fill="#000000"
                            Data="M860.28261 619.782c-8.12-26.086-19.204-56.506-30.427-85.72 0 0-6.456-0.795-9.718 0.148-100.71 29.205-222.773 47.818-315.792 46.695h-0.962C410.88561 582.017 289.65061 563.617 189.27961 534.698 185.44461 533.595 177.87261 534.063 177.87261 534.063 166.64961 563.276 155.56661 593.696 147.44761 619.782 108.72961 744.168 121.27261 795.644 130.82461 796.798c20.496 2.474 79.78-93.637 79.78-93.637 0 97.66 88.324 247.617 290.576 248.996a718.01 718.01 0 0 1 5.367 0C708.80161 950.778 797.12261 800.822 797.12261 703.162c0 0 59.284 96.111 79.783 93.637 9.55-1.154 22.093-52.63-16.623-177.017" />
                      <Path Stretch="None" Fill="#FFFFFF"
                            Data="M434.38261 316.917c-27.9 1.24-51.745-30.106-53.24-69.956-1.518-39.877 19.858-73.207 47.764-74.454 27.875-1.224 51.703 30.109 53.218 69.974 1.527 39.877-19.853 73.2-47.742 74.436m206.67-69.956c-1.494 39.85-25.34 71.194-53.24 69.956-27.888-1.238-49.269-34.559-47.742-74.435 1.513-39.868 25.341-71.201 53.216-69.974 27.909 1.247 49.285 34.576 47.767 74.453" />
                      <Path Stretch="None" Fill="#FAAD08"
                            Data="M683.94261 368.627c-7.323-17.609-81.062-37.227-172.353-37.227h-0.98c-91.29 0-165.031 19.618-172.352 37.227a6.244 6.244 0 0 0-0.535 2.505c0 1.269 0.393 2.414 1.006 3.386 6.168 9.765 88.054 58.018 171.882 58.018h0.98c83.827 0 165.71-48.25 171.881-58.016a6.352 6.352 0 0 0 1.002-3.395c0-0.897-0.2-1.736-0.531-2.498" />
                      <Path Stretch="None" Fill="#000000"
                            Data="M467.63161 256.377c1.26 15.886-7.377 30-19.266 31.542-11.907 1.544-22.569-10.083-23.836-25.978-1.243-15.895 7.381-30.008 19.25-31.538 11.927-1.549 22.607 10.088 23.852 25.974m73.097 7.935c2.533-4.118 19.827-25.77 55.62-17.886 9.401 2.07 13.75 5.116 14.668 6.316 1.355 1.77 1.726 4.29 0.352 7.684-2.722 6.725-8.338 6.542-11.454 5.226-2.01-0.85-26.94-15.889-49.905 6.553-1.579 1.545-4.405 2.074-7.085 0.242-2.678-1.834-3.786-5.553-2.196-8.135" />
                      <Path Stretch="None" Fill="#FFFFFF"
                            Data="M504.33261 584.495h-0.967c-63.568 0.752-140.646-7.504-215.286-21.92-6.391 36.262-10.25 81.838-6.936 136.196 8.37 137.384 91.62 223.736 220.118 224.996H506.48461c128.498-1.26 211.748-87.612 220.12-224.996 3.314-54.362-0.547-99.938-6.94-136.203-74.654 14.423-151.745 22.684-215.332 21.927" />
                      <Path Stretch="None" Fill="#EB1C26"
                            Data="M323.27461 577.016v137.468s64.957 12.705 130.031 3.91V591.59c-41.225-2.262-85.688-7.304-130.031-14.574" />
                      <Path Stretch="None" Fill="#EB1C26"
                            Data="M788.09761 432.536s-121.98 40.387-283.743 41.539h-0.962c-161.497-1.147-283.328-41.401-283.744-41.539l-40.854 106.952c102.186 32.31 228.837 53.135 324.598 51.926l0.96-0.002c95.768 1.216 222.4-19.61 324.6-51.924l-40.855-106.952z" />
                      </Canvas>
                    </Viewbox>
                  </Border>
                </Grid>
                <TextBlock Text="QQ群" FontSize="12" Foreground="#493F38"
                           HorizontalAlignment="Center" />
              </StackPanel>
            </Button>
          </Grid>
        </StackPanel>

        <Border Padding="14,12" CornerRadius="11" Background="#FFFEFC"
                BorderBrush="#EAE2D9" BorderThickness="1">
          <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
            <StackPanel Spacing="3">
              <TextBlock Text="版本更新" FontSize="14" FontWeight="SemiBold" />
              <TextBlock x:Name="CurrentVersionText" Text="当前版本 v0.0.4"
                         FontSize="12" Foreground="#756B63" />
              <TextBlock x:Name="UpdateStatusText" Text="正在检查 Gitee 发行版…"
                         FontSize="12" Foreground="#756B63" TextWrapping="Wrap" />
            </StackPanel>
            <Button x:Name="UpdateActionButton" Grid.Column="1" VerticalAlignment="Center"
                    Width="104" MinWidth="104" Padding="0" Click="UpdateAction_Click"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                    ToolTip.Tip="检查 Gitee 是否发布了更新版本。">
              <TextBlock x:Name="UpdateActionButtonText" Text="检查更新"
                         HorizontalAlignment="Stretch" VerticalAlignment="Center"
                         TextAlignment="Center" />
            </Button>
            <ProgressBar x:Name="UpdateProgressBar" Grid.Row="1" Grid.ColumnSpan="2"
                         Height="8" Margin="0,10,0,0" Minimum="0" Maximum="100"
                         IsVisible="False" Foreground="#A95032" Background="#EAE2D9" />
            <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" Margin="0,6,0,0">
              <TextBlock x:Name="DownloadProgressText" FontSize="11" Foreground="#756B63"
                         VerticalAlignment="Center" />
              <Button x:Name="PauseResumeButton" Grid.Column="1" Content="暂停"
                      Classes="secondary" MinHeight="28" Padding="10,4"
                      HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                      IsVisible="False" Click="PauseResume_Click" />
            </Grid>
          </Grid>
        </Border>

        <TextBlock Text="感谢使用 Cheems翻译" FontSize="12" Foreground="#8B8077"
                   HorizontalAlignment="Center" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
