<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:CursorTranslator.Services"
        x:Class="CursorTranslator.Services.SpeechHttpProfilesWindow"
        Icon="/Assets/translator_icon.ico"
        Title="HTTP 语音接口档案" Width="1080" Height="790"
        MinWidth="900" MinHeight="670"
        WindowStartupLocation="CenterOwner"
        CanResize="True" SystemDecorations="None"
        Background="Transparent" TransparencyLevelHint="Transparent"
        Foreground="#302B27">
  <Window.Styles>
    <StyleInclude Source="avares://CursorTranslator/Assets/HttpManagementStyles.axaml" />
  </Window.Styles>

  <Border Classes="management-window-surface" PointerPressed="WindowSurface_PointerPressed">
    <Grid RowDefinitions="40,Auto,*,Auto">
      <controls:ManagementWindowTitleBar Grid.Row="0" Title="HTTP 语音接口档案" />

      <Grid Classes="management-window-heading-row" Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel Spacing="3">
          <TextBlock Text="HTTP 语音接口" Classes="management-window-heading" />
        </StackPanel>
      </Grid>

      <Grid Classes="management-window-content-row" Grid.Row="2" ColumnDefinitions="224,*" ColumnSpacing="14">
        <Border Classes="management-window-sidebar">
          <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
            <StackPanel Margin="2,2,2,0" Spacing="3">
              <TextBlock Classes="management-window-section-heading" Text="接口档案" />
            </StackPanel>
            <ListBox x:Name="ProfileListBox" Grid.Row="1" Classes="profile-list"
                     SelectionChanged="ProfileList_SelectionChanged">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="4">
                    <TextBlock Classes="profile-name" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="1" Classes="profile-delete" ToolTip.Tip="删除此档案"
                            Click="DeleteProfile_Click">
                      <Path Data="M 3,4 L 13,4 M 5,4 L 5,13 L 11,13 L 11,4 M 6,4 L 6,2 L 10,2 L 10,4 M 7,6 L 7,11 M 9,6 L 9,11"
                            Stroke="#A95032" StrokeThickness="1.4" Fill="Transparent" />
                    </Button>
                    <TextBlock Classes="profile-subtitle" Grid.Row="1" Text="{Binding ProtocolDisplay}" FontSize="10"
                               VerticalAlignment="Center" />
                    <Border Grid.Row="1" Grid.Column="1" Padding="6,2" CornerRadius="6"
                            Background="#F3EEE8" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Response.Format}" FontSize="10" Foreground="#756B63" />
                    </Border>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Button Grid.Row="2" Content="新增档案" Classes="secondary" HorizontalAlignment="Stretch"
                    Click="NewProfile_Click" />
          </Grid>
        </Border>

        <Border Grid.Column="1" Classes="management-window-editor">
          <TabControl x:Name="EditorTabs" SelectionChanged="EditorTabs_SelectionChanged">
            <TabItem Header="基础设置">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="2,10,8,8" Spacing="12">
                  <Border Padding="12" CornerRadius="10" Background="#F8F1E9" BorderBrush="#E9D8C8" BorderThickness="1">
                    <StackPanel Spacing="6">
                        <TextBlock Text="快速开始" FontWeight="SemiBold" FontSize="14" />
                        <ComboBox x:Name="PresetComboBox" SelectedIndex="0"
                                  SelectionChanged="PresetComboBox_SelectionChanged">
                          <ComboBoxItem Content="选择一个预设…" Tag="" />
                          <ComboBoxItem Content="通用 HTTP · POST JSON / WAV" Tag="GenericPost" />
                          <ComboBoxItem Content="通用 HTTP · GET 参数 / JSON 音频" Tag="GenericGet" />
                          <ComboBoxItem Content="合我意预设 · GET / MP3" Tag="Hewoyi" />
                          <ComboBoxItem Content="Microsoft Edge TTS · 免费神经语音" Tag="EdgeTts" />
                        </ComboBox>
                    </StackPanel>
                  </Border>

                  <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Border Padding="12" CornerRadius="10" Background="#FFFFFF" BorderBrush="#EEE6DE" BorderThickness="1">
                      <StackPanel Spacing="8">
                        <TextBlock Text="接口与模型" FontSize="14" FontWeight="SemiBold" />
                        <StackPanel Spacing="4">
                          <TextBlock Text="档案名称" FontSize="11" Foreground="#756B63" />
                          <TextBox x:Name="ProfileNameBox" Watermark="例如：公司语音服务" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                          <TextBlock Text="接口地址 URL" FontSize="11" Foreground="#756B63" />
                          <TextBox x:Name="EndpointBox" Watermark="https://example.com/v1/tts" />
                        </StackPanel>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                          <StackPanel Spacing="4">
                            <TextBlock Text="请求方式" FontSize="11" Foreground="#756B63" />
                            <ComboBox x:Name="MethodComboBox" SelectedIndex="1">
                              <ComboBoxItem Content="GET" Tag="GET" />
                              <ComboBoxItem Content="POST" Tag="POST" />
                              <ComboBoxItem Content="PUT" Tag="PUT" />
                            </ComboBox>
                          </StackPanel>
                          <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="超时（秒）" FontSize="11" Foreground="#756B63" />
                            <TextBox x:Name="TimeoutBox" Text="90" />
                          </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                          <StackPanel Spacing="4">
                            <TextBlock Text="模型名称（可选）" FontSize="11" Foreground="#756B63" />
                            <TextBox x:Name="ModelBox" Watermark="model" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="音色（可选）" FontSize="11" Foreground="#756B63" />
                            <TextBox x:Name="VoiceBox" Watermark="voice" />
                          </StackPanel>
                        </Grid>
                      </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Padding="12" CornerRadius="10" Background="#FFFFFF" BorderBrush="#EEE6DE" BorderThickness="1">
                      <StackPanel Spacing="8">
                        <TextBlock Text="鉴权与账号" FontSize="14" FontWeight="SemiBold" />
                        <StackPanel Spacing="4">
                          <TextBlock Text="鉴权方式" FontSize="11" Foreground="#756B63" />
                          <ComboBox x:Name="AuthTypeComboBox" SelectedIndex="1">
                            <ComboBoxItem Content="不需要鉴权" Tag="None" />
                            <ComboBoxItem Content="Bearer Token" Tag="Bearer" />
                            <ComboBoxItem Content="API Key 请求头" Tag="ApiKeyHeader" />
                            <ComboBoxItem Content="API Key 查询参数" Tag="ApiKeyQuery" />
                            <ComboBoxItem Content="Basic 用户名密码" Tag="Basic" />
                            <ComboBoxItem Content="HMAC-SHA256 签名" Tag="HmacSha256" />
                          </ComboBox>
                        </StackPanel>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                          <StackPanel Spacing="4">
                            <TextBlock Text="请求头名称" FontSize="11" Foreground="#756B63" />
                            <TextBox x:Name="AuthHeaderNameBox" Text="Authorization" />
                          </StackPanel>
                          <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="查询参数名" FontSize="11" Foreground="#756B63" />
                            <TextBox x:Name="AuthQueryNameBox" Text="api_key" />
                          </StackPanel>
                        </Grid>
                        <StackPanel Spacing="4">
                          <TextBlock Text="用户名（仅 Basic 模式）" FontSize="11" Foreground="#756B63" />
                          <TextBox x:Name="AuthUsernameBox" Watermark="用户名" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                          <TextBlock Text="API Key / 密码" FontSize="11" Foreground="#756B63" />
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox x:Name="ProfileApiKeyBox" PasswordChar="●" Watermark="填写后会加密保存在本机" />
                            <Button x:Name="ProfileApiKeyVisibilityButton" Grid.Column="1" Classes="secondary"
                                    Width="38" Padding="0" Click="ToggleProfileApiKeyVisibility_Click"
                                    ToolTip.Tip="显示 API Key">
                              <Grid Width="18" Height="16">
                                <Path Data="M 1,8 C 4,2 14,2 17,8 C 14,14 4,14 1,8 Z"
                                      Stroke="#684B3C" StrokeThickness="1.5" Fill="Transparent" />
                                <Ellipse Width="4" Height="4" Fill="#684B3C"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Path x:Name="ProfileApiKeyEyeSlash" Data="M 2,1 L 16,15"
                                      Stroke="#684B3C" StrokeThickness="1.5" IsVisible="False" />
                              </Grid>
                            </Button>
                          </Grid>
                        </StackPanel>
                        <StackPanel Spacing="4">
                          <TextBlock Text="API Secret（仅 HMAC 模式）" FontSize="11" Foreground="#756B63" />
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox x:Name="ProfileApiSecretBox" PasswordChar="●" Watermark="签名密钥" />
                            <Button x:Name="ProfileApiSecretVisibilityButton" Grid.Column="1" Classes="secondary"
                                    Width="38" Padding="0" Click="ToggleProfileApiSecretVisibility_Click"
                                    ToolTip.Tip="显示 API Secret">
                              <Grid Width="18" Height="16">
                                <Path Data="M 1,8 C 4,2 14,2 17,8 C 14,14 4,14 1,8 Z"
                                      Stroke="#684B3C" StrokeThickness="1.5" Fill="Transparent" />
                                <Ellipse Width="4" Height="4" Fill="#684B3C"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Path x:Name="ProfileApiSecretEyeSlash" Data="M 2,1 L 16,15"
                                      Stroke="#684B3C" StrokeThickness="1.5" IsVisible="False" />
                              </Grid>
                            </Button>
                          </Grid>
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </Grid>

                  <Border Padding="12" CornerRadius="10" Background="#FFFFFF" BorderBrush="#EEE6DE" BorderThickness="1">
                    <StackPanel Spacing="8">
                      <TextBlock Text="返回音频" FontSize="14" FontWeight="SemiBold" />
                      <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                        <StackPanel Spacing="4">
                          <TextBlock Text="响应类型" FontSize="11" Foreground="#756B63" />
                          <ComboBox x:Name="ResponseTypeComboBox" SelectedIndex="0">
                            <ComboBoxItem Content="直接返回音频" Tag="RawAudio" />
                            <ComboBoxItem Content="JSON 中的 Base64" Tag="JsonBase64" />
                            <ComboBoxItem Content="JSON 中的音频 URL" Tag="JsonUrl" />
                            <ComboBoxItem Content="JSON Base64 或 URL（自动识别）" Tag="JsonBase64OrUrl" />
                          </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                          <TextBlock Text="音频格式" FontSize="11" Foreground="#756B63" />
                          <ComboBox x:Name="ResponseFormatComboBox" SelectedIndex="0">
                            <ComboBoxItem Content="WAV" Tag="Wav" />
                            <ComboBoxItem Content="PCM" Tag="Pcm" />
                            <ComboBoxItem Content="MP3" Tag="Mp3" />
                          </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="4">
                          <TextBlock Text="JSON 音频字段路径（可留空自动找）" FontSize="11" Foreground="#756B63" />
                          <TextBox x:Name="ResponseJsonPathBox" Watermark="例如 data.audio_url；留空自动识别" />
                        </StackPanel>
                      </Grid>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </ScrollViewer>
            </TabItem>

            <TabItem Header="高级配置">
              <Grid Margin="2,10,2,4" RowDefinitions="Auto,*,Auto" RowSpacing="9">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                  <TextBlock Text="完整接口档案" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Content="复制 JSON" Classes="secondary" Click="CopyProfileJson_Click" />
                  <Button Grid.Column="2" Content="粘贴导入" Classes="secondary" Click="PasteProfileJson_Click" />
                </Grid>
                <TextBox x:Name="ProfileJsonBox" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True"
                         TextWrapping="NoWrap" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"
                         Watermark="接口档案 JSON" />
                <TextBlock x:Name="ProfileErrorText" Grid.Row="2" IsVisible="False"
                           Foreground="#B42318" FontSize="11" TextWrapping="Wrap" />
              </Grid>
            </TabItem>
          </TabControl>
        </Border>
      </Grid>

      <Grid Classes="management-window-footer" Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="10">
        <TextBlock x:Name="FooterErrorText" VerticalAlignment="Center" Foreground="#B42318"
                   FontSize="11" TextWrapping="Wrap" IsVisible="False" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
          <Button Content="取消" Classes="secondary" Click="Cancel_Click" />
          <Button Content="保存并使用当前档案" Click="Save_Click" />
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
