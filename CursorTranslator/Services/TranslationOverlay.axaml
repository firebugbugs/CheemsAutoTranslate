<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CursorTranslator.Services.TranslationOverlay"
        Width="560" Height="56" MinWidth="220" MaxWidth="600" MinHeight="56" MaxHeight="520"
        SizeToContent="Manual"
        SystemDecorations="None" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" CanResize="False"
        Background="Transparent"
        TransparencyLevelHint="Transparent">
  <Window.Resources>
    <TranslateTransform x:Key="PositionLockIconOffset" X="1" Y="0" />
  </Window.Resources>
  <Window.Styles>
    <Style Selector="Button.svg-icon-button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.svg-icon-button:pointerover">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Opacity" Value="0.68" />
    </Style>
    <Style Selector="Button.svg-icon-button:pressed">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Opacity" Value="0.42" />
    </Style>
    <Style Selector="ToggleButton.position-lock-checkbox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Template">
        <ControlTemplate TargetType="ToggleButton">
          <Border Background="{TemplateBinding Background}" CornerRadius="5">
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="ToggleButton.position-lock-checkbox:checked">
      <Setter Property="Background" Value="#E5E5E5" />
    </Style>
    <Style Selector="ToggleButton.position-lock-checkbox:pointerover">
      <Setter Property="Opacity" Value="0.72" />
    </Style>
    <Style Selector="ToggleButton.position-lock-checkbox:pressed">
      <Setter Property="Opacity" Value="0.42" />
    </Style>
  </Window.Styles>
  <Border x:Name="CardBorder" Background="#EF111827" CornerRadius="11" BorderBrush="#607AEE" BorderThickness="1" Padding="12,8"
          PointerPressed="Card_PointerPressed" PointerReleased="Card_PointerReleased" Cursor="SizeAll">
    <Border.ContextMenu>
      <ContextMenu>
        <MenuItem Header="返回主页面" Click="ReturnToMainPage_Click" />
      </ContextMenu>
    </Border.ContextMenu>
    <StackPanel>
      <Grid ColumnDefinitions="*,Auto" MinHeight="38">
        <ScrollViewer x:Name="TranslationScrollViewer" Grid.Column="0" MinHeight="38" MaxHeight="420"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <SelectableTextBlock x:Name="TranslationText" Margin="2,2,12,2" Foreground="White"
                               SelectionBrush="#607AEE" SelectionForegroundBrush="White"
                               FontSize="17" TextWrapping="Wrap" VerticalAlignment="Top">
            <SelectableTextBlock.Inlines>
              <Run x:Name="TranslationRun" />
              <Run Text=" " />
              <InlineUIContainer BaselineAlignment="Center">
                <Button x:Name="CopyButton" Classes="svg-icon-button" Width="20" Height="20"
                        VerticalAlignment="Center" Cursor="Hand" Click="CopyAllTranslation_Click"
                        ToolTip.Tip="复制全部翻译">
                  <Grid Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path x:Name="CopyIcon" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Fill="{Binding #CopyButton.Foreground}"
                          Data="M267.3 834.6h-96.5c-27.4 0-49.7-22.3-49.7-49.7V115.2c0-27.4 22.3-49.7 49.7-49.7H727c27.4 0 49.7 22.3 49.7 49.7v96.5h-42.6v-96.5c0-3.9-3.2-7.1-7.1-7.1H170.8c-3.9 0-7.1 3.2-7.1 7.1v669.7c0 3.9 3.2 7.1 7.1 7.1h96.5v42.6z M851.9 959.5H295.7c-27.4 0-49.7-22.3-49.7-49.7V240.1c0-27.4 22.3-49.7 49.7-49.7h556.2c27.4 0 49.7 22.3 49.7 49.7v669.7c-0.1 27.4-22.3 49.7-49.7 49.7zM295.7 233c-3.9 0-7.1 3.2-7.1 7.1v669.7c0 3.9 3.2 7.1 7.1 7.1h556.2c3.9 0 7.1-3.2 7.1-7.1V240.1c0-3.9-3.2-7.1-7.1-7.1H295.7z" />
                  </Grid>
                </Button>
              </InlineUIContainer>
              <Run Text=" " />
              <InlineUIContainer BaselineAlignment="Center">
                <Button x:Name="AnalyzeButton" Classes="svg-icon-button" Width="20" Height="20"
                        Foreground="{Binding #TranslationText.Foreground}" IsEnabled="False"
                        VerticalAlignment="Center" Cursor="Hand"
                        Click="AnalyzeTranslation_Click" ToolTip.Tip="选中译文词语后自动讲解；点击分析原文译法">
                  <Grid Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"><Path Stretch="Uniform" Fill="{Binding #AnalyzeButton.Foreground}" Data="M730.927181 285.337393H265.363542c-23.871854 0-43.2443-19.372447-43.244301-43.244301s19.372447-43.2443 43.244301-43.2443h465.563639c23.871854 0 43.2443 19.372447 43.2443 43.2443s-19.372446 43.244301-43.2443 43.244301z m-118.734351 203.973116H265.363542c-23.621887-0.374951-42.619383-19.622414-42.619383-43.2443s18.997496-42.86935 42.619383-43.244301h346.954271c23.621887 0.374951 42.619383 19.622414 42.619383 43.244301-0.124984 23.496903-19.12248 42.744366-42.744366 43.2443zM486.709368 690.409005H265.363542c-23.621887-0.374951-42.619383-19.622414-42.619383-43.244301s18.997496-42.86935 42.619383-43.2443h221.345826c23.621887-0.374951 42.619383 19.622414 42.619383 43.2443-0.124984 23.496903-18.997496 42.86935-42.619383 43.244301z m260.465671 176.47674c-82.364144 0-149.730266-65.366385-152.604886-147.730529S654.937196 567.425214 737.051374 561.800955c82.114177-5.499275 153.979706 55.117736 162.103634 136.981946 8.49888 83.863947-52.618065 158.854063-136.606995 167.227959-4.999341 0.624918-10.248649 0.874885-15.372974 0.874885z m0.374951-235.468965c-2.749638 0-5.499275 0.124984-8.49888 0.37495-33.370602 3.374555-61.366912 26.496508-71.115627 58.617275s0.999868 66.866187 26.871458 87.988403c25.996574 21.2472 62.241797 24.746738 91.612926 8.748847s46.493872-47.993674 43.119317-81.364277c-3.999473-42.244432-39.619778-74.240215-81.989194-74.365198z M930.775841 892.257401l-94.487547-98.362036c-13.12327-12.248386-33.370602-11.873435-45.993938 0.999868-12.623336 12.873303-12.873303 32.995651-0.249967 46.118922l94.487547 98.237052c5.374292 5.249308 12.498353 8.748847 20.122348 9.498748 13.873172 1.374819 27.246409-6.37416 33.120634-18.997496 5.624259-12.74832 2.999605-27.746343-6.999077-37.495058z M179.999793 1023.865055c-66.991171-0.124984-121.109038-54.367834-121.234022-121.234021V121.234021c0.124984-66.991171 54.367834-121.109038 121.234022-121.234021h639.415725c66.991171 0.124984 121.109038 54.367834 121.234021 121.234021v319.082946c-0.374951 23.621887-19.622414 42.619383-43.2443 42.619382-23.621887 0-42.86935-18.997496-43.2443-42.619382V121.234021c0-19.12248-15.497957-34.620437-34.620437-34.74542H179.999793C160.877313 86.613584 145.379356 102.111542 145.254372 121.234021v781.397013C145.379356 921.753514 160.877313 937.376454 179.999793 937.376454h424.444058s42.494399 2.499671 42.494399 45.494004c0 42.86935-42.494399 41.11958-42.494399 41.119581H179.999793v-0.124984z" /></Grid>
                </Button>
              </InlineUIContainer>
            </SelectableTextBlock.Inlines>
            <SelectableTextBlock.ContextMenu>
              <ContextMenu>
                <MenuItem Header="复制" Click="CopyTranslation_Click" />
                <MenuItem x:Name="SpeakTranslationMenuItem" Header="朗读"
                          IsVisible="False" Click="SpeakTranslationSelection_Click" />
                <Separator />
                <MenuItem Header="返回主页面" Click="ReturnToMainPage_Click" />
              </ContextMenu>
            </SelectableTextBlock.ContextMenu>
          </SelectableTextBlock>
        </ScrollViewer>
        <StackPanel x:Name="ActionButtonsPanel" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Spacing="2">
          <Button x:Name="SpeakerButton" Classes="svg-icon-button" Width="24" Height="24"
                  Cursor="Hand" Click="SpeakerButton_Click" ToolTip.Tip="播放译文语音">
            <Path x:Name="SpeakerIcon" Width="17" Height="17" Stretch="Uniform"
                  Data="M283.221333 341.333333H256a85.333333 85.333333 0 0 0-85.333333 85.333334v170.666666a85.333333 85.333333 0 0 0 58.325333 80.981334v0.042666a42.666667 42.666667 0 0 1-26.965333 80.896l-1.194667-0.384A170.752 170.752 0 0 1 85.333333 597.333333v-170.666666a170.666667 170.666667 0 0 1 170.666667-170.666667h27.221333a42.666667 42.666667 0 0 0 27.306667-9.898667l92.202667-76.8C513.92 76.586667 682.666667 155.605333 682.666667 300.373333v423.253334c0 144.682667-168.746667 223.744-279.893334 131.114666L352.426667 812.8a42.624 42.624 0 0 1 25.557333-76.842667c11.093333 0 21.205333 4.266667 28.8 11.178667l0.042667-0.085333 50.517333 42.069333c55.552 46.336 139.946667 6.826667 139.946667-65.536V300.373333c0-72.362667-84.394667-111.872-139.946667-65.536l-92.245333 76.8A128 128 0 0 1 283.264 341.333333zM841.386667 269.056a42.666667 42.666667 0 0 0-61.44 59.221333C818.773333 368.64 853.333333 436.266667 853.333333 512s-34.56 143.36-73.386666 183.722667a42.666667 42.666667 0 0 0 61.44 59.221333C893.610667 700.672 938.666667 612.48 938.666667 512s-45.056-188.672-97.28-242.944z" />
          </Button>
          <Button x:Name="SettingsButton" Classes="svg-icon-button" Width="24" Height="24"
                  Cursor="Hand" Click="SettingsButton_Click" ToolTip.Tip="卡片设置">
            <Path x:Name="SettingsIcon" Width="17" Height="17" Stretch="Uniform"
                  Data="M624.170667 178.133333a160 160 0 0 1 138.581333 80l107.413333 186.069334a160 160 0 0 1 0 160l-107.413333 186.069333a160 160 0 0 1-138.581333 80H409.322667a160 160 0 0 1-138.581334-80l-107.434666-186.069333a160 160 0 0 1 0-160l107.434666-186.090667a160 160 0 0 1 138.581334-80z m0 64H409.322667a96 96 0 0 0-83.157334 48l-107.413333 186.069334a96 96 0 0 0 0 96l107.413333 186.069333a96 96 0 0 0 83.157334 48h214.848a96 96 0 0 0 83.136-48l107.434666-186.069333a96 96 0 0 0 0-96l-107.434666-186.090667a96 96 0 0 0-83.136-48z m-107.434667 143.402667a138.666667 138.666667 0 1 1 0 277.333333 138.666667 138.666667 0 0 1 0-277.333333z m0 64a74.666667 74.666667 0 1 0 0 149.333333 74.666667 74.666667 0 0 0 0-149.333333z" />
          </Button>
          <ToggleButton x:Name="PositionLockToggle" Classes="position-lock-checkbox" Width="24" Height="24"
                        Cursor="Hand" Checked="PositionLockToggle_Changed" Unchecked="PositionLockToggle_Changed"
                        ToolTip.Tip="锁定浮层位置">
            <Grid Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Path x:Name="PositionLockIcon" Width="17" Height="17" Stretch="Uniform"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  RenderTransform="{StaticResource PositionLockIconOffset}"
                  Data="M270.118128 307.243574C270.118128 173.883915 378.618553 65.361702 512 65.361702 645.35966 65.361702 753.860085 173.883915 753.860085 307.243574L753.860085 354.914043 270.118128 354.914043 270.118128 307.243574ZM827.914894 354.914043 819.221787 354.914043 819.221787 305.740255C819.221787 305.217362 819.091064 304.716255 819.069277 304.215149 817.413447 136.213787 680.371745 0 512 0 343.606468 0 206.564766 136.213787 204.908936 304.215149 204.887149 304.738043 204.756426 305.217362 204.756426 305.740255L204.756426 354.914043 196.085106 354.914043C130.004426 354.914043 76.255319 408.663149 76.255319 474.722043L76.255319 635.468255C76.255319 653.529872 90.874553 668.149106 108.93617 668.149106 126.976 668.149106 141.617021 653.529872 141.617021 635.468255L141.617021 474.722043C141.617021 444.699234 166.040511 420.253957 196.085106 420.253957L827.914894 420.253957C857.937702 420.253957 882.382979 444.699234 882.382979 474.722043L882.382979 796.693787C882.382979 904.344511 842.664851 948.267574 745.341277 948.267574L278.636936 948.267574C181.313362 948.267574 141.617021 904.344511 141.617021 796.693787 141.617021 778.653957 126.976 764.012936 108.93617 764.012936 90.874553 764.012936 76.255319 778.653957 76.255319 796.693787 76.255319 940.642043 144.340426 1013.629277 278.636936 1013.629277L745.341277 1013.629277C879.659574 1013.629277 947.744681 940.642043 947.744681 796.693787L947.744681 474.722043C947.744681 408.663149 893.973787 354.914043 827.914894 354.914043ZM511.991285 835.716902C536.828732 835.716902 557.025498 815.040817 557.025498 789.615115L557.025498 680.766094C578.159115 665.66754 591.03537 640.677583 591.03537 614.031796 591.03537 569.237243 555.565753 532.7872 511.991285 532.7872 468.416817 532.7872 432.9472 569.237243 432.9472 614.031796 432.9472 640.677583 445.845243 665.689328 467.000647 680.766094L467.000647 789.615115C467.000647 815.040817 487.175626 835.716902 511.991285 835.716902Z" />
            </Grid>
          </ToggleButton>
          <Button x:Name="CloseButton" Classes="svg-icon-button" Width="24" Height="24"
                  Cursor="Hand" Click="CloseButton_Click" ToolTip.Tip="关闭浮层">
            <Path x:Name="CloseIcon" Width="15" Height="15" Stretch="Uniform"
                  Data="M728.095 208.315l-204.907 204.907-204.907-204.907c-23.309-23.309-61.347-23.309-84.666 0l-2.452 2.452c-23.309 23.309-23.309 61.347 0 84.666l204.907 204.907-204.907 204.907c-23.309 23.309-23.309 61.347 0 84.666l2.452 2.452c23.309 23.309 61.347 23.309 84.666 0l204.907-204.907 204.907 204.907c23.309 23.309 61.347 23.309 84.666 0l2.452-2.452c23.309-23.309 23.309-61.347 0-84.666l-204.907-204.907 204.907-204.907c23.309-23.309 23.309-61.347 0-84.666l-2.452-2.452c-23.309-23.309-61.347-23.309-84.666 0z" />
          </Button>
        </StackPanel>
      </Grid>
      <Border x:Name="DeepAnalysisPanel" IsVisible="False" Margin="0,6,0,0" Padding="8,8,4,2"
              BorderBrush="#557F8FA4" BorderThickness="0,1,0,0">
        <Grid RowDefinitions="Auto,*" RowSpacing="6">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <TextBlock Text="AI 深度分析" FontSize="13" FontWeight="SemiBold"
                         Foreground="{Binding #TranslationText.Foreground}" />
              <TextBlock x:Name="DeepAnalysisStatusText" Text="正在分析"
                         FontSize="11" Foreground="{Binding #TranslationText.Foreground}"
                         Opacity="0.72" VerticalAlignment="Center" />
            </StackPanel>
            <Button Grid.Column="1" Classes="svg-icon-button" Width="20" Height="20"
                    Cursor="Hand" Click="HideDeepAnalysis_Click" ToolTip.Tip="收起分析结果">
              <TextBlock Text="×" FontSize="18" Foreground="{Binding #TranslationText.Foreground}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
          </Grid>
          <ScrollViewer x:Name="DeepAnalysisScrollViewer" Grid.Row="1" MaxHeight="220"
                        VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="DeepAnalysisContent" Spacing="6" HorizontalAlignment="Stretch" />
          </ScrollViewer>
        </Grid>
      </Border>
      <Border x:Name="AppearancePanel" IsVisible="False" Margin="0,6,0,0" Padding="4,8,2,2"
              BorderBrush="#557F8FA4" BorderThickness="0,1,0,0">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="76,*" ColumnSpacing="8">
            <TextBlock Text="透明度" VerticalAlignment="Center" Foreground="{Binding #TranslationText.Foreground}" />
            <Slider x:Name="OpacitySlider" Grid.Column="1" Minimum="0.25" Maximum="1"
                    Value="0.8" VerticalAlignment="Center" ValueChanged="OpacitySlider_ValueChanged" />
          </Grid>
          <Grid ColumnDefinitions="76,*" ColumnSpacing="8">
            <TextBlock Text="主题" VerticalAlignment="Center" Foreground="{Binding #TranslationText.Foreground}" />
            <ComboBox x:Name="ThemeBox" Grid.Column="1" SelectedIndex="1"
                      SelectionChanged="ThemeBox_SelectionChanged">
              <ComboBoxItem Content="深色" Tag="Dark" />
              <ComboBoxItem Content="浅色" Tag="Light" />
              <ComboBoxItem Content="蓝色" Tag="Blue" />
              <ComboBoxItem Content="绿色" Tag="Green" />
            </ComboBox>
          </Grid>
          <Grid ColumnDefinitions="76,*,36" ColumnSpacing="8">
            <TextBlock Text="字号" VerticalAlignment="Center" Foreground="{Binding #TranslationText.Foreground}" />
            <Slider x:Name="FontSizeSlider" Grid.Column="1" Minimum="10" Maximum="48" Value="17"
                    SmallChange="1" TickFrequency="1" IsSnapToTickEnabled="True"
                    VerticalAlignment="Center" ValueChanged="FontSizeSlider_ValueChanged" />
            <TextBlock x:Name="FontSizeValue" Grid.Column="2" Text="17" VerticalAlignment="Center"
                       TextAlignment="Right" Foreground="{Binding #TranslationText.Foreground}" />
          </Grid>
          <Grid ColumnDefinitions="76,*" ColumnSpacing="8">
            <TextBlock Text="字体" VerticalAlignment="Center" Foreground="{Binding #TranslationText.Foreground}" />
            <ComboBox x:Name="FontFamilyBox" Grid.Column="1"
                      SelectionChanged="FontFamilyBox_SelectionChanged" />
          </Grid>
          <Grid ColumnDefinitions="76,*" ColumnSpacing="8">
            <TextBlock Text="字重" VerticalAlignment="Center" Foreground="{Binding #TranslationText.Foreground}" />
            <CheckBox x:Name="FontBoldCheckBox" Grid.Column="1" Content="加粗"
                      Checked="FontBoldCheckBox_Changed" Unchecked="FontBoldCheckBox_Changed" />
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>
  </Border>
</Window>
