<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CursorTranslator.Services.TranslationOverlay"
        Width="560" Height="56" MinWidth="220" MaxWidth="600" MinHeight="56" MaxHeight="520"
        SizeToContent="Manual"
        SystemDecorations="None" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" CanResize="False"
        Background="Transparent"
        TransparencyLevelHint="Transparent">
  <Window.Styles>
    <Style Selector="Button.svg-icon-button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.svg-icon-button:pointerover">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Opacity" Value="0.68" />
    </Style>
    <Style Selector="Button.svg-icon-button:pressed">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Opacity" Value="0.42" />
    </Style>
  </Window.Styles>
  <Border x:Name="CardBorder" Background="#EF111827" CornerRadius="11" BorderBrush="#607AEE" BorderThickness="1" Padding="12,8"
          PointerPressed="Card_PointerPressed" PointerReleased="Card_PointerReleased" Cursor="SizeAll">
    <StackPanel>
      <Grid ColumnDefinitions="*,Auto" MinHeight="38">
        <ScrollViewer x:Name="TranslationScrollViewer" Grid.Column="0" Height="38" MaxHeight="280"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <SelectableTextBlock x:Name="TranslationText" Margin="2,2,12,2" Foreground="White"
                               SelectionBrush="#607AEE" SelectionForegroundBrush="White"
                               FontSize="17" TextWrapping="Wrap" VerticalAlignment="Top">
            <SelectableTextBlock.Inlines>
              <Run x:Name="TranslationRun" />
              <Run Text=" " />
              <InlineUIContainer BaselineAlignment="Center">
                <Button x:Name="CopyButton" Classes="svg-icon-button" Width="20" Height="20"
                        VerticalAlignment="Center" Cursor="Hand" Click="CopyAllTranslation_Click"
                        ToolTip.Tip="复制全部翻译">
                  <Grid Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path x:Name="CopyIcon" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Fill="{Binding #CopyButton.Foreground}"
                          Data="M267.3 834.6h-96.5c-27.4 0-49.7-22.3-49.7-49.7V115.2c0-27.4 22.3-49.7 49.7-49.7H727c27.4 0 49.7 22.3 49.7 49.7v96.5h-42.6v-96.5c0-3.9-3.2-7.1-7.1-7.1H170.8c-3.9 0-7.1 3.2-7.1 7.1v669.7c0 3.9 3.2 7.1 7.1 7.1h96.5v42.6z M851.9 959.5H295.7c-27.4 0-49.7-22.3-49.7-49.7V240.1c0-27.4 22.3-49.7 49.7-49.7h556.2c27.4 0 49.7 22.3 49.7 49.7v669.7c-0.1 27.4-22.3 49.7-49.7 49.7zM295.7 233c-3.9 0-7.1 3.2-7.1 7.1v669.7c0 3.9 3.2 7.1 7.1 7.1h556.2c3.9 0 7.1-3.2 7.1-7.1V240.1c0-3.9-3.2-7.1-7.1-7.1H295.7z" />
                  </Grid>
                </Button>
              </InlineUIContainer>
            </SelectableTextBlock.Inlines>
            <SelectableTextBlock.ContextMenu>
              <ContextMenu>
                <MenuItem Header="复制" Click="CopyTranslation_Click" />
                <MenuItem Header="问 AI" Click="AskAi_Click" />
              </ContextMenu>
            </SelectableTextBlock.ContextMenu>
          </SelectableTextBlock>
        </ScrollViewer>
        <StackPanel x:Name="ActionButtonsPanel" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Spacing="2">
          <Button x:Name="SpeakerButton" Classes="svg-icon-button" Width="24" Height="24"
                  Cursor="Hand" Click="SpeakerButton_Click" ToolTip.Tip="播放译文语音">
            <Path x:Name="SpeakerIcon" Width="17" Height="17" Stretch="Uniform"
                  Data="M283.221333 341.333333H256a85.333333 85.333333 0 0 0-85.333333 85.333334v170.666666a85.333333 85.333333 0 0 0 58.325333 80.981334v0.042666a42.666667 42.666667 0 0 1-26.965333 80.896l-1.194667-0.384A170.752 170.752 0 0 1 85.333333 597.333333v-170.666666a170.666667 170.666667 0 0 1 170.666667-170.666667h27.221333a42.666667 42.666667 0 0 0 27.306667-9.898667l92.202667-76.8C513.92 76.586667 682.666667 155.605333 682.666667 300.373333v423.253334c0 144.682667-168.746667 223.744-279.893334 131.114666L352.426667 812.8a42.624 42.624 0 0 1 25.557333-76.842667c11.093333 0 21.205333 4.266667 28.8 11.178667l0.042667-0.085333 50.517333 42.069333c55.552 46.336 139.946667 6.826667 139.946667-65.536V300.373333c0-72.362667-84.394667-111.872-139.946667-65.536l-92.245333 76.8A128 128 0 0 1 283.264 341.333333zM841.386667 269.056a42.666667 42.666667 0 0 0-61.44 59.221333C818.773333 368.64 853.333333 436.266667 853.333333 512s-34.56 143.36-73.386666 183.722667a42.666667 42.666667 0 0 0 61.44 59.221333C893.610667 700.672 938.666667 612.48 938.666667 512s-45.056-188.672-97.28-242.944z" />
          </Button>
          <Button x:Name="SettingsButton" Classes="svg-icon-button" Width="24" Height="24"
                  Cursor="Hand" Click="SettingsButton_Click" ToolTip.Tip="卡片设置">
            <Path x:Name="SettingsIcon" Width="17" Height="17" Stretch="Uniform"
                  Data="M624.170667 178.133333a160 160 0 0 1 138.581333 80l107.413333 186.069334a160 160 0 0 1 0 160l-107.413333 186.069333a160 160 0 0 1-138.581333 80H409.322667a160 160 0 0 1-138.581334-80l-107.434666-186.069333a160 160 0 0 1 0-160l107.434666-186.090667a160 160 0 0 1 138.581334-80z m0 64H409.322667a96 96 0 0 0-83.157334 48l-107.413333 186.069334a96 96 0 0 0 0 96l107.413333 186.069333a96 96 0 0 0 83.157334 48h214.848a96 96 0 0 0 83.136-48l107.434666-186.069333a96 96 0 0 0 0-96l-107.434666-186.090667a96 96 0 0 0-83.136-48z m-107.434667 143.402667a138.666667 138.666667 0 1 1 0 277.333333 138.666667 138.666667 0 0 1 0-277.333333z m0 64a74.666667 74.666667 0 1 0 0 149.333333 74.666667 74.666667 0 0 0 0-149.333333z" />
          </Button>
          <Button x:Name="CloseButton" Classes="svg-icon-button" Width="24" Height="24"
                  Cursor="Hand" Click="CloseButton_Click" ToolTip.Tip="关闭浮层">
            <Path x:Name="CloseIcon" Width="15" Height="15" Stretch="Uniform"
                  Data="M728.095 208.315l-204.907 204.907-204.907-204.907c-23.309-23.309-61.347-23.309-84.666 0l-2.452 2.452c-23.309 23.309-23.309 61.347 0 84.666l204.907 204.907-204.907 204.907c-23.309 23.309-23.309 61.347 0 84.666l2.452 2.452c23.309 23.309 61.347 23.309 84.666 0l204.907-204.907 204.907 204.907c23.309 23.309 61.347 23.309 84.666 0l2.452-2.452c23.309-23.309 23.309-61.347 0-84.666l-204.907-204.907 204.907-204.907c23.309-23.309 23.309-61.347 0-84.666l-2.452-2.452c-23.309-23.309-61.347-23.309-84.666 0z" />
          </Button>
        </StackPanel>
      </Grid>
      <Border x:Name="AppearancePanel" IsVisible="False" Margin="0,6,0,0" Padding="4,8,2,2"
              BorderBrush="#557F8FA4" BorderThickness="0,1,0,0">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="76,*" ColumnSpacing="8">
            <TextBlock Text="透明度" VerticalAlignment="Center" Foreground="{Binding #TranslationText.Foreground}" />
            <Slider x:Name="OpacitySlider" Grid.Column="1" Minimum="0.25" Maximum="1"
                    Value="0.8" VerticalAlignment="Center" ValueChanged="OpacitySlider_ValueChanged" />
          </Grid>
          <Grid ColumnDefinitions="76,*" ColumnSpacing="8">
            <TextBlock Text="主题" VerticalAlignment="Center" Foreground="{Binding #TranslationText.Foreground}" />
            <ComboBox x:Name="ThemeBox" Grid.Column="1" SelectedIndex="1"
                      SelectionChanged="ThemeBox_SelectionChanged">
              <ComboBoxItem Content="深色" Tag="Dark" />
              <ComboBoxItem Content="浅色" Tag="Light" />
              <ComboBoxItem Content="蓝色" Tag="Blue" />
              <ComboBoxItem Content="绿色" Tag="Green" />
            </ComboBox>
          </Grid>
          <Grid ColumnDefinitions="76,*,36" ColumnSpacing="8">
            <TextBlock Text="字号" VerticalAlignment="Center" Foreground="{Binding #TranslationText.Foreground}" />
            <Slider x:Name="FontSizeSlider" Grid.Column="1" Minimum="10" Maximum="48" Value="17"
                    SmallChange="1" TickFrequency="1" IsSnapToTickEnabled="True"
                    VerticalAlignment="Center" ValueChanged="FontSizeSlider_ValueChanged" />
            <TextBlock x:Name="FontSizeValue" Grid.Column="2" Text="17" VerticalAlignment="Center"
                       TextAlignment="Right" Foreground="{Binding #TranslationText.Foreground}" />
          </Grid>
          <Grid ColumnDefinitions="76,*" ColumnSpacing="8">
            <TextBlock Text="字体" VerticalAlignment="Center" Foreground="{Binding #TranslationText.Foreground}" />
            <ComboBox x:Name="FontFamilyBox" Grid.Column="1"
                      SelectionChanged="FontFamilyBox_SelectionChanged" />
          </Grid>
          <Grid ColumnDefinitions="76,*" ColumnSpacing="8">
            <TextBlock Text="字重" VerticalAlignment="Center" Foreground="{Binding #TranslationText.Foreground}" />
            <CheckBox x:Name="FontBoldCheckBox" Grid.Column="1" Content="加粗"
                      Checked="FontBoldCheckBox_Changed" Unchecked="FontBoldCheckBox_Changed" />
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>
  </Border>
</Window>
