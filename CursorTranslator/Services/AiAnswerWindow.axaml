<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CursorTranslator.Services.AiAnswerWindow"
        Width="420" MinWidth="300" MaxWidth="520"
        Height="170" MinHeight="110" MaxHeight="360"
        SizeToContent="Height"
        SystemDecorations="None" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" CanResize="False"
        Background="Transparent"
        TransparencyLevelHint="Transparent">
  <Border Background="#F3111827" CornerRadius="11" BorderBrush="#607AEE" BorderThickness="1" Padding="14,10">
    <Grid RowDefinitions="Auto,*" MinHeight="80" MaxHeight="330">
      <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
        <TextBlock Text="AI 释义" Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
        <Button Grid.Column="1" Content="×" Width="28" Height="24" Padding="0" MinWidth="0"
                Background="Transparent" Foreground="White" BorderThickness="0"
                Cursor="Hand" Click="CloseButton_Click" ToolTip.Tip="关闭释义" />
      </Grid>
      <ScrollViewer Grid.Row="1" MaxHeight="280" VerticalScrollBarVisibility="Auto">
        <SelectableTextBlock x:Name="AnswerText" Foreground="White" FontSize="15"
                             TextWrapping="Wrap" SelectionBrush="#607AEE" SelectionForegroundBrush="White" />
      </ScrollViewer>
    </Grid>
  </Border>
</Window>
