<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="using:Avalonia.Controls.Primitives"
        x:Class="CursorTranslator.MainWindow"
        Icon="/Assets/translator_icon.ico"
        Title="Cheems翻译"
        Width="940" Height="700" MinWidth="820" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        CanResize="True" SystemDecorations="None"
        Background="Transparent" TransparencyLevelHint="Transparent"
        Foreground="#302B27">
  <Window.Styles>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#302B27" />
      <Setter Property="BorderBrush" Value="#E6DED5" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="9,6" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="TextBox:focus">
      <Setter Property="BorderBrush" Value="#B65D3B" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="#493F38" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button">
      <Setter Property="Background" Value="#A95032" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#A95032" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button:pointerover">
      <Setter Property="Background" Value="#914329" />
      <Setter Property="BorderBrush" Value="#914329" />
    </Style>
    <Style Selector="Button:pressed">
      <Setter Property="Background" Value="#793820" />
      <Setter Property="BorderBrush" Value="#793820" />
    </Style>
    <Style Selector="Button.icon-button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#655A52" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.icon-button:pointerover">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Opacity" Value="0.68" />
    </Style>
    <Style Selector="Button.icon-button:pressed">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Opacity" Value="0.42" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="#F7F1EB" />
      <Setter Property="Foreground" Value="#684B3C" />
      <Setter Property="BorderBrush" Value="#E7D8CA" />
    </Style>
    <Style Selector="Button.secondary:pointerover">
      <Setter Property="Background" Value="#F0E5DA" />
      <Setter Property="BorderBrush" Value="#D9C6B5" />
    </Style>
    <Style Selector="ToggleButton.startup-toggle">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="ToggleButton.startup-toggle:pointerover">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
  </Window.Styles>

  <Border Margin="8" CornerRadius="14" Background="#FAF8F5" BorderBrush="#DCD2C8" BorderThickness="1"
          ClipToBounds="True" PointerPressed="WindowSurface_PointerPressed">
    <Grid RowDefinitions="40,*">
      <Grid x:Name="TitleBar" ColumnDefinitions="*,Auto" Margin="10,2,8,0">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Image Source="/Assets/translator_icon.png" Width="20" Height="20"
                 Stretch="Uniform" RenderOptions.BitmapInterpolationMode="HighQuality"
                 VerticalAlignment="Center" />
          <TextBlock Text="Cheems翻译" FontSize="13" Foreground="#756B63" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
          <Button x:Name="StatisticsButton" Classes="window-control" ToolTip.Tip="每日统计"
                  Click="ShowStatistics_Click">
            <Grid Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Path Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Fill="{Binding #StatisticsButton.Foreground}"
                    Data="M917 872H107c-24.9 0-45 20.1-45 45s20.1 45 45 45h810c24.9 0 45-20.1 45-45s-20.1-45-45-45zM182 782c66.3 0 120-53.7 120-120V482c0-66.3-53.7-120-120-120S62 415.7 62 482v180c0 66.3 53.7 120 120 120z m-30-300c0-16.6 13.4-30 30-30s30 13.4 30 30v180c0 16.6-13.4 30-30 30s-30-13.4-30-30V482zM512 782c66.3 0 120-53.7 120-120V362c0-66.3-53.7-120-120-120s-120 53.7-120 120v300c0 66.3 53.7 120 120 120z m-30-420c0-16.6 13.4-30 30-30s30 13.4 30 30v300c0 16.6-13.4 30-30 30s-30-13.4-30-30V362zM842 62c-66.3 0-120 53.7-120 120v480c0 66.3 53.7 120 120 120s120-53.7 120-120V182c0-66.3-53.7-120-120-120z m30 600c0 16.6-13.4 30-30 30s-30-13.4-30-30V182c0-16.6 13.4-30 30-30s30 13.4 30 30v480z" />
            </Grid>
          </Button>
          <Button x:Name="MinimizeWindowButton" Classes="window-control" ToolTip.Tip="最小化"
                  Click="MinimizeWindow_Click">
            <Grid Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Path Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Fill="{Binding #MinimizeWindowButton.Foreground}"
                  Data="{StaticResource WindowMinimizeGeometry}" />
            </Grid>
          </Button>
          <Button x:Name="MaximizeButton" Classes="window-control" ToolTip.Tip="最大化"
                  Click="ToggleWindowState_Click">
            <Grid Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Path x:Name="MaximizeIcon" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Fill="{Binding #MaximizeButton.Foreground}"
                    Data="{StaticResource WindowMaximizeGeometry}" />
              <Path x:Name="RestoreIcon" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                    IsVisible="False"
                    Fill="{Binding #MaximizeButton.Foreground}"
                    Data="{StaticResource WindowRestoreGeometry}" />
            </Grid>
          </Button>
          <Button x:Name="CloseWindowButton" Classes="window-control close" ToolTip.Tip="关闭设置窗口"
                  Click="CloseWindow_Click">
            <Grid Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Path Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Fill="{Binding #CloseWindowButton.Foreground}"
                  Data="{StaticResource WindowCloseGeometry}" />
            </Grid>
          </Button>
        </StackPanel>
      </Grid>

      <Border Grid.Row="1" Padding="18,12,18,16">
        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,*" ColumnSpacing="14" RowSpacing="10">
          <Grid Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <Border Padding="10,7" CornerRadius="10"
                    Background="#FFFEFC" BorderBrush="#EAE2D9" BorderThickness="1">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <TextBlock x:Name="MonitorStateText" Text="监控中" FontSize="12" FontWeight="SemiBold"
                           Foreground="#9E4B2E" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText" Grid.Column="1" Text="设置翻译接口" FontSize="12"
                           Foreground="#756B63" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           ToolTip.Tip="运行状态和错误信息。" />
              </Grid>
            </Border>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <TextBlock Text="随系统启动" FontSize="13" Foreground="#684B3C" VerticalAlignment="Center" />
              <primitives:ToggleButton x:Name="StartupToggle" Classes="startup-toggle" Click="Startup_Click"
                                       Cursor="Hand" ToolTip.Tip="登录 Windows 后在后台启动 Cheems翻译。">
                <Border x:Name="StartupToggleTrack" Width="48" Height="28" CornerRadius="14"
                        Background="#E8DED4" BorderBrush="#D7C8BA" BorderThickness="1">
                  <Ellipse x:Name="StartupToggleThumb" Width="20" Height="20" Margin="3"
                           Fill="#FFFEFC" HorizontalAlignment="Left" VerticalAlignment="Center" />
                </Border>
              </primitives:ToggleButton>
              <TextBlock x:Name="StartupStateText" Text="关" Width="25" FontSize="12"
                         Foreground="#756B63" VerticalAlignment="Center" />
              <Button x:Name="AboutButton" Classes="icon-button" Width="30" Height="30"
                      Click="ShowAbout_Click" Cursor="Hand" ToolTip.Tip="关于 Cheems翻译">
                <Grid Width="18" Height="18">
                  <Path Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Fill="{Binding #AboutButton.Foreground}"
                        Data="M618 669.9c-89.6 77.4-62.5-58.4-58.4-77.4 4.1-19 62.4-135.8 19.7-155.4-42.8-19.7-174.5 77.4-174.5 77.4s-21.7 15.6-19.7 19.7c14.3 25.1 77.4-19.7 77.4-19.7s21.7-17.6 19.7 0c-19 76.5-32 154.3-38.7 232.8 9.5 51.6 91 29.9 154.8-38.7 63.8-68.5 19.7-38.7 19.7-38.7z m0 0 M566 378c24.2 1.3 47.3-10.4 60.5-30.7 13.2-20.3 14.7-46.1 3.7-67.8-11-21.6-32.6-35.8-56.9-37.1-24.2-1.3-47.3 10.4-60.5 30.7-13.2 20.3-14.7 46.1-3.7 67.8 11 21.6 32.7 35.8 56.9 37.1z m0 0 M884.8 853.9c87.3-93.3 135.9-216.4 135.8-344.2C1020.6 228.5 792.7 0.6 511.5 0.6 230.3 0.6 2.4 228.6 2.4 509.7c0 281.2 227.9 509.1 509.1 509.1h475.2c14.3 0.1 27.1-8.7 32.1-22 5-13.4 1.1-28.4-9.7-37.7L884.8 853.9zM511.5 951C267.8 951 70.2 753.4 70.2 509.7 70.2 266 267.7 68.5 511.4 68.5S952.6 266 952.6 509.7c0.4 122.1-50.3 238.8-139.8 321.8-7.1 7-10.7 16.8-9.9 26.7 0.8 9.9 5.9 19 14 24.9l80.8 67.9H511.5z m0 0" />
                </Grid>
              </Button>
            </StackPanel>
          </Grid>

          <Border Grid.Row="1" Grid.Column="0" Padding="14" CornerRadius="13"
                  Background="#FFFEFC" BorderBrush="#EAE2D9" BorderThickness="1" ClipToBounds="True">
            <Grid ClipToBounds="True">
              <TextBlock Text="翻译模型" FontSize="72" FontWeight="Bold" Foreground="#A95032"
                         Opacity="0.14" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                         Margin="0,0,14,10" IsHitTestVisible="False" />
              <TabControl x:Name="TranslationProviderTabs" Background="Transparent">
              <TabItem x:Name="AiProviderTab">
                <TabItem.Header>
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="AI 接入" />
                    <TextBlock x:Name="AiProviderCheckMark" Text="✓" Foreground="#38875B"
                               FontWeight="Bold" IsVisible="False" />
                  </StackPanel>
                </TabItem.Header>
                <StackPanel Spacing="8" Margin="2,8,2,2">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="OpenAI 兼容接口" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                    <ToggleSwitch x:Name="EnableAiProviderSwitch" Grid.Column="1" OnContent="启用" OffContent="停用"
                                  Checked="TranslationProviderSwitch_Changed" Unchecked="TranslationProviderSwitch_Changed"
                                  ToolTip.Tip="启用后使用此 AI 接口翻译；同一时间只启用一个翻译接口。" />
                  </Grid>
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <StackPanel Spacing="4">
                      <TextBlock Text="API 地址" FontSize="12" FontWeight="SemiBold" Foreground="#655A52" />
                      <TextBox x:Name="EndpointBox" Watermark="http://127.0.0.1:11434/v1"
                               ToolTip.Tip="OpenAI 兼容接口地址。Ollama 默认端口是 11434。" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4">
                      <TextBlock Text="模型名称" FontSize="12" FontWeight="SemiBold" Foreground="#655A52" />
                      <TextBox x:Name="ModelBox" Watermark="模型名称"
                               ToolTip.Tip="填写服务端可用的模型名称。" />
                    </StackPanel>
                  </Grid>

                  <StackPanel Spacing="4">
                    <TextBlock Text="API Key（可选）" FontSize="12" FontWeight="SemiBold" Foreground="#655A52" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <TextBox x:Name="ApiKeyBox" PasswordChar="●" Watermark="API Key"
                               ToolTip.Tip="可留空；本地 Ollama 可填写 ollama。填写的密钥使用 Windows DPAPI 加密保存。" />
                      <Button x:Name="ApiKeyVisibilityButton" Grid.Column="1" Classes="secondary" Width="38" Padding="0"
                              Click="ToggleApiKeyVisibility_Click" ToolTip.Tip="显示 API Key">
                        <Grid Width="18" Height="16">
                          <Path Data="M 1,8 C 4,2 14,2 17,8 C 14,14 4,14 1,8 Z"
                                Stroke="#684B3C" StrokeThickness="1.5" Fill="Transparent" />
                          <Ellipse Width="4" Height="4" Fill="#684B3C"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                          <Path x:Name="ApiKeyEyeSlash" Data="M 2,1 L 16,15" Stroke="#684B3C"
                                StrokeThickness="1.5" IsVisible="False" />
                        </Grid>
                      </Button>
                    </Grid>
                  </StackPanel>

                  <StackPanel Spacing="4">
                    <TextBlock Text="翻译指令" FontSize="12" FontWeight="SemiBold" Foreground="#655A52" />
                    <TextBox x:Name="SystemPromptBox" AcceptsReturn="True" MinHeight="68" TextWrapping="Wrap"
                             Watermark="翻译指令" ToolTip.Tip="设定目标语言、语气和格式要求。" />
                  </StackPanel>
                </StackPanel>
              </TabItem>

              <TabItem x:Name="HttpProviderTab">
                <TabItem.Header>
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="HTTP 接入" />
                    <TextBlock x:Name="HttpProviderCheckMark" Text="✓" Foreground="#38875B"
                               FontWeight="Bold" IsVisible="False" />
                  </StackPanel>
                </TabItem.Header>
                <StackPanel Spacing="8" Margin="2,8,2,2">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="HTTP 翻译接口" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                    <ToggleSwitch x:Name="EnableHttpProviderSwitch" Grid.Column="1" OnContent="启用" OffContent="停用"
                                  Checked="TranslationProviderSwitch_Changed" Unchecked="TranslationProviderSwitch_Changed"
                                  ToolTip.Tip="启用后通过兼容的 HTTP 文本翻译接口翻译；同一时间只启用一个翻译接口。" />
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <ComboBox x:Name="HttpTranslationProfileComboBox" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                              ToolTip.Tip="选择当前使用的 HTTP 翻译接口档案。" />
                    <Button Grid.Column="1" Content="管理HTTP接口" Classes="secondary"
                            Click="ManageTranslationHttpProfiles_Click" />
                  </Grid>
                  <TextBlock Text="接口地址、语言、请求格式、鉴权及译文字段都在接口档案中配置；API Key 等密钥会加密保存在本机。"
                             FontSize="11" Foreground="#756B63" TextWrapping="Wrap" />
                </StackPanel>
              </TabItem>
              </TabControl>
            </Grid>
          </Border>

          <Border Grid.Row="1" Grid.Column="1" Padding="14" CornerRadius="13"
                  Background="#FFFEFC" BorderBrush="#EAE2D9" BorderThickness="1" ClipToBounds="True">
            <Grid ClipToBounds="True">
              <TextBlock Text="语音模型" FontSize="72" FontWeight="Bold" Foreground="#A95032"
                         Opacity="0.14" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                         Margin="0,0,14,10" IsHitTestVisible="False" />
              <StackPanel Spacing="8">
              <TabControl x:Name="SpeechProviderTabs" Background="Transparent">
                <TabItem x:Name="SpeechAiProviderTab">
                  <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <TextBlock Text="AI 接入" />
                      <TextBlock x:Name="SpeechAiProviderCheckMark" Text="✓" Foreground="#38875B"
                                 FontWeight="Bold" IsVisible="False" />
                    </StackPanel>
                  </TabItem.Header>
                  <StackPanel Spacing="8" Margin="2,8,2,2">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="OpenAI 兼容接口" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                      <ToggleSwitch x:Name="EnableSpeechAiSwitch" Grid.Column="1" OnContent="启用" OffContent="停用"
                                    Checked="SpeechProviderSwitch_Changed" Unchecked="SpeechProviderSwitch_Changed"
                                    ToolTip.Tip="启用后通过 OpenAI 兼容接口合成语音；同一时间只启用一个语音接口。" />
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                      <StackPanel Spacing="4">
                        <TextBlock Text="API 地址" FontSize="12" FontWeight="SemiBold" Foreground="#655A52" />
                        <TextBox x:Name="SpeechEndpointBox" Watermark="OpenAI 兼容 API 根地址"
                                 ToolTip.Tip="OpenAI 兼容模式会请求此地址下的 /audio/speech 路径。" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="模型名称" FontSize="12" FontWeight="SemiBold" Foreground="#655A52" />
                        <TextBox x:Name="SpeechModelBox" Watermark="模型名称"
                                 ToolTip.Tip="填写语音服务端支持的文字转语音模型名称。" />
                      </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                      <StackPanel Spacing="4">
                        <TextBlock Text="API Key（可选）" FontSize="12" FontWeight="SemiBold" Foreground="#655A52" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                          <TextBox x:Name="SpeechApiKeyBox" PasswordChar="●" Watermark="API Key"
                                   ToolTip.Tip="可留空；填写的密钥使用 Windows DPAPI 加密保存。" />
                          <Button x:Name="SpeechApiKeyVisibilityButton" Grid.Column="1" Classes="secondary" Width="38" Padding="0"
                                  Click="ToggleSpeechApiKeyVisibility_Click" ToolTip.Tip="显示 API Key">
                            <Grid Width="18" Height="16">
                              <Path Data="M 1,8 C 4,2 14,2 17,8 C 14,14 4,14 1,8 Z"
                                    Stroke="#684B3C" StrokeThickness="1.5" Fill="Transparent" />
                              <Ellipse Width="4" Height="4" Fill="#684B3C"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                              <Path x:Name="SpeechApiKeyEyeSlash" Data="M 2,1 L 16,15" Stroke="#684B3C"
                                    StrokeThickness="1.5" IsVisible="False" />
                            </Grid>
                          </Button>
                        </Grid>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="音色" FontSize="12" FontWeight="SemiBold" Foreground="#655A52" />
                        <TextBox x:Name="SpeechVoiceBox" Text="alloy" Watermark="alloy"
                                 ToolTip.Tip="填写语音服务支持的音色名称，例如 alloy。" />
                      </StackPanel>
                    </Grid>
                  </StackPanel>
                </TabItem>
                <TabItem x:Name="SpeechHttpProviderTab">
                  <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <TextBlock Text="HTTP 接入" />
                      <TextBlock x:Name="SpeechHttpProviderCheckMark" Text="✓" Foreground="#38875B"
                                 FontWeight="Bold" IsVisible="False" />
                    </StackPanel>
                  </TabItem.Header>
                  <StackPanel Spacing="8" Margin="2,8,2,2">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="通用 HTTP 语音接口" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                      <ToggleSwitch x:Name="EnableSpeechHttpSwitch" Grid.Column="1" OnContent="启用" OffContent="停用"
                                    Checked="SpeechProviderSwitch_Changed" Unchecked="SpeechProviderSwitch_Changed"
                                    ToolTip.Tip="启用后通过已配置的 HTTP 接口档案合成语音；同一时间只启用一个语音接口。" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <ComboBox x:Name="HttpSpeechProfileComboBox" HorizontalAlignment="Stretch"
                                VerticalAlignment="Center" />
                      <Button Grid.Column="1" Content="管理HTTP接口" Classes="secondary"
                              Click="ManageSpeechHttpProfiles_Click" />
                    </Grid>
                  </StackPanel>
                </TabItem>
              </TabControl>
              </StackPanel>
              <CheckBox x:Name="RealTimeSpeechCheckBox" Content="实时语音"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,2"
                        Checked="RealTimeSpeech_Changed" Unchecked="RealTimeSpeech_Changed"
                        ToolTip.Tip="开启后，每次翻译完成都会自动播报；新播报会停止并替换上一条语音。" />
            </Grid>
          </Border>

          <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="1.25*,*,2*" ColumnSpacing="10">
          <Border Grid.Column="0" Padding="14" CornerRadius="13" Background="#FFFEFC"
                    BorderBrush="#EAE2D9" BorderThickness="1">
            <StackPanel Spacing="8">
                <TextBlock Text="翻译时机" FontSize="16" FontWeight="Bold"
                           ToolTip.Tip="句末和延迟触发可同时启用；文字变化模式会关闭其他方式。" />
                <CheckBox x:Name="TranslateOnTextChangeCheckBox" IsChecked="True" Content="文字变化"
                          Checked="TranslationTriggerOption_Changed" Unchecked="TranslationTriggerOption_Changed"
                          ToolTip.Tip="每次检测到文本变化就立即翻译，是最频繁的模式；选中后其他方式不可选。" />
                <CheckBox x:Name="TranslateOnSentenceEndCheckBox" Content="句末"
                          Checked="TranslationTriggerOption_Changed" Unchecked="TranslationTriggerOption_Changed"
                          ToolTip.Tip="识别到句末标点后立即翻译。" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <CheckBox x:Name="TranslateAfterInactivityCheckBox" Content="停顿后"
                            VerticalAlignment="Center"
                            Checked="TranslationTriggerOption_Changed" Unchecked="TranslationTriggerOption_Changed"
                            ToolTip.Tip="没有句末标点时，在停止输入达到指定时长后翻译。" />
                  <TextBox x:Name="InactivityDelaySecondsBox" Width="84" Text="2" Watermark="2"
                           TextAlignment="Center" ToolTip.Tip="直接输入秒数，支持小数点，范围 0.5 到 60 秒。" />
                  <TextBlock Text="秒" VerticalAlignment="Center" FontSize="13" Foreground="#655A52" />
                </StackPanel>
            </StackPanel>
          </Border>

          <Border Grid.Column="1" Padding="14" CornerRadius="13" Background="#FFFEFC"
                    BorderBrush="#EAE2D9" BorderThickness="1">
            <StackPanel Spacing="12">
              <TextBlock Text="最多翻译" FontSize="16" FontWeight="Bold"
                         ToolTip.Tip="完整句子不会直接按设置数值从中间截断，会自动寻找断句。" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox x:Name="MaximumTranslationCharactersBox" Width="84" Text="10" Watermark="10"
                         MaxLength="4" TextAlignment="Center"
                         ToolTip.Tip="范围 5 到 1000；中文按字、英文按单词计数，标点不计。" />
                <TextBlock Text="字/词" VerticalAlignment="Center" FontSize="13" Foreground="#655A52" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Grid.Column="2" Padding="14" CornerRadius="13" Background="#FFFEFC"
                    BorderBrush="#EAE2D9" BorderThickness="1">
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="试译" FontSize="16" FontWeight="Bold" />
                  <TextBlock x:Name="TestProviderLabel" Grid.Column="1" Text="当前：AI 接入"
                             FontSize="11" Foreground="#756B63" VerticalAlignment="Center" />
                </Grid>
                <TextBox x:Name="TestInputBox" Text="你好世界" AcceptsReturn="True" MinHeight="54"
                         TextWrapping="Wrap" Watermark="输入测试文本"
                         ToolTip.Tip="手动试译不会启动输入监控。" />
                <Button x:Name="TestButton" Content="翻译" HorizontalAlignment="Left" Click="TranslateTest_Click"
                        Width="60" Height="34" MinHeight="34" Padding="0"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                <Border Padding="10,8" CornerRadius="8" Background="#FBF7F2"
                        BorderBrush="#EFE5DA" BorderThickness="1">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                    <TextBlock x:Name="TestResultText" Text="" MinHeight="22" TextWrapping="Wrap"
                               FontSize="13" Foreground="#51463F" VerticalAlignment="Center" />
                    <Button x:Name="TestSpeakButton" Grid.Column="1" Classes="icon-button"
                            IsEnabled="False" Cursor="Hand" Click="TestSpeak_Click"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            ToolTip.Tip="播放试译结果">
                      <Grid Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Width="18" Height="18" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Fill="{Binding #TestSpeakButton.Foreground}"
                              Data="M283.221333 341.333333H256a85.333333 85.333333 0 0 0-85.333333 85.333334v170.666666a85.333333 85.333333 0 0 0 58.325333 80.981334v0.042666a42.666667 42.666667 0 0 1-26.965333 80.896l-1.194667-0.384A170.752 170.752 0 0 1 85.333333 597.333333v-170.666666a170.666667 170.666667 0 0 1 170.666667-170.666667h27.221333a42.666667 42.666667 0 0 0 27.306667-9.898667l92.202667-76.8C513.92 76.586667 682.666667 155.605333 682.666667 300.373333v423.253334c0 144.682667-168.746667 223.744-279.893334 131.114666L352.426667 812.8a42.624 42.624 0 0 1 25.557333-76.842667c11.093333 0 21.205333 4.266667 28.8 11.178667l0.042667-0.085333 50.517333 42.069333c55.552 46.336 139.946667 6.826667 139.946667-65.536V300.373333c0-72.362667-84.394667-111.872-139.946667-65.536l-92.245333 76.8A128 128 0 0 1 283.264 341.333333zM841.386667 269.056a42.666667 42.666667 0 0 0-61.44 59.221333C818.773333 368.64 853.333333 436.266667 853.333333 512s-34.56 143.36-73.386666 183.722667a42.666667 42.666667 0 0 0 61.44 59.221333C893.610667 700.672 938.666667 612.48 938.666667 512s-45.056-188.672-97.28-242.944z" />
                      </Grid>
                    </Button>
                  </Grid>
                </Border>
            </StackPanel>
          </Border>
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
