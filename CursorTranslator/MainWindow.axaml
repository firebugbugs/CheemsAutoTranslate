<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="using:Avalonia.Controls.Primitives"
        x:Class="CursorTranslator.MainWindow"
        Icon="/Assets/translator_icon.ico"
        Title="Cheems翻译"
        Width="940" Height="760" MinWidth="820" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        CanResize="True" SystemDecorations="None"
        Background="Transparent" TransparencyLevelHint="Transparent"
        Foreground="#302B27" PointerPressed="WindowSurface_PointerPressed"
        PointerMoved="WindowSurface_PointerMoved" PointerReleased="WindowSurface_PointerReleased">
  <Window.Styles>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#302B27" />
      <Setter Property="BorderBrush" Value="#E6DED5" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="9,6" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="TextBox:focus">
      <Setter Property="BorderBrush" Value="#B65D3B" />
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="#493F38" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button">
      <Setter Property="Background" Value="#A95032" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#A95032" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button:pointerover">
      <Setter Property="Background" Value="#914329" />
      <Setter Property="BorderBrush" Value="#914329" />
    </Style>
    <Style Selector="Button:pressed">
      <Setter Property="Background" Value="#793820" />
      <Setter Property="BorderBrush" Value="#793820" />
    </Style>
    <Style Selector="Button.icon-button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#655A52" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.icon-button:pointerover">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Opacity" Value="0.68" />
    </Style>
    <Style Selector="Button.icon-button:pressed">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Opacity" Value="0.42" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="#F7F1EB" />
      <Setter Property="Foreground" Value="#684B3C" />
      <Setter Property="BorderBrush" Value="#E7D8CA" />
    </Style>
    <Style Selector="Button.secondary:pointerover">
      <Setter Property="Background" Value="#F0E5DA" />
      <Setter Property="BorderBrush" Value="#D9C6B5" />
    </Style>
    <Style Selector="ToggleButton.startup-toggle">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="ToggleButton.startup-toggle:pointerover">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
  </Window.Styles>

  <Grid>
  <Border x:Name="WindowSurface" Margin="8" CornerRadius="14" Background="#FAF8F5" BorderBrush="#DCD2C8" BorderThickness="1"
          ClipToBounds="True" PointerPressed="WindowSurface_PointerPressed">
    <Grid RowDefinitions="40,*">
      <Grid x:Name="TitleBar" ColumnDefinitions="*,Auto" Margin="10,2,8,0">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Image Source="/Assets/translator_icon.png" Width="20" Height="20"
                 Stretch="Uniform" RenderOptions.BitmapInterpolationMode="HighQuality"
                 VerticalAlignment="Center" />
          <TextBlock Text="Cheems翻译" FontSize="13" Foreground="#756B63" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
          <Button x:Name="SettingsButton" Classes="window-control" ToolTip.Tip="翻译设置"
                  Click="OpenTranslationSettings_Click">
            <Viewbox Width="20" Height="20" Stretch="Uniform"
                     HorizontalAlignment="Center" VerticalAlignment="Center">
              <Canvas Width="1024" Height="1024">
              <Path Width="1024" Height="1024" Stretch="None" HorizontalAlignment="Left"
                    VerticalAlignment="Top" Fill="{Binding #SettingsButton.Foreground}"
                    Data="M510.37806 337.803609c-98.010221 0-177.748287 78.842673-177.748287 175.75284 0 96.91426 79.738066 175.763073 177.748287 175.763073 9.537214 0 19.620873-0.978281 31.797194-3.088338 18.196431-3.281743 30.290887-20.538779 26.963095-38.471197-2.924609-15.732309-16.693194-27.152407-32.747845-27.152407-2.071172 0-4.15974 0.196475-6.123464 0.563842-7.937786 1.402953-14.233166 2.056845-19.807115 2.056845-61.159942 0-110.915136-49.201585-110.915136-109.671819 0-60.467163 49.679469-109.661585 110.747313-109.661585 61.116963 0 110.832248 49.194422 110.832248 109.661585 0 5.892197-0.656963 12.0832-2.088568 19.531845-3.327792 17.928325 8.769734 35.189454 26.959002 38.464033 2.006703 0.360204 4.045129 0.546446 6.070252 0.546446 16.204054 0 30.019711-11.43033 32.832779-27.116591 2.13871-11.45182 3.13848-21.435195 3.13848-31.41857 0.042979-46.873564-18.435884-90.990341-52.033074-124.223233C602.407056 356.106464 557.790906 337.803609 510.37806 337.803609z" />
              <Path Width="1024" Height="1024" Stretch="None" HorizontalAlignment="Left"
                    VerticalAlignment="Top" Fill="{Binding #SettingsButton.Foreground}"
                    Data="M938.476161 432.79917c-2.185782-11.426237-11.037381-20.499893-22.563902-23.12058-41.909505-9.508561-76.781734-34.929534-98.185206-71.550593-21.334911-36.560684-26.191522-79.099523-13.68979-119.709429 3.52836-11.123338 0.007163-23.235191-8.951883-30.840402-41.860387-35.721573-89.536222-62.938448-141.695163-80.885192-3.152806-1.088798-6.437619-1.639337-9.776667-1.639337-8.256034 0-16.182564 3.431146-21.724791 9.376555-29.236881 31.04404-68.840878 48.140417-111.5107 48.140417-42.673915 0-82.305541-17.125029-111.607914-48.230468-7.877411-8.333806-20.510126-11.512195-31.580253-7.726985-52.483328 18.171871-100.131535 45.416376-141.640927 80.988546-8.815783 7.591909-12.322653 19.620873-8.934486 30.67258 12.586666 40.645722 7.759731 83.180468-13.597693 119.78106-21.306258 36.5965-56.149834 62.006216-98.17395 71.561849-11.540847 2.709715-20.396539 11.812023-22.559808 23.166629-5.228071 27.169803-7.877411 54.346769-7.877411 80.770582 0 26.426883 2.64934 53.603849 7.873318 80.763418 2.174526 11.411911 11.023054 20.488637 22.552645 23.12058 41.913599 9.512654 76.785827 34.922371 98.19237 71.547523 21.349237 36.59343 26.177196 79.128175 13.583366 119.795387-3.363607 10.969842 0.121773 23.013133 8.973372 30.758538 41.84913 35.707246 89.494267 62.920028 141.662417 80.902588 11.466146 3.885494 23.738657 0.549515 31.454386-7.680936 29.29828-31.091112 68.925812-48.216141 111.593588-48.216141s82.302471 17.125029 111.560842 48.183396c5.556553 5.955642 13.494339 9.380648 21.782096 9.380648 3.27765 0 6.537903-0.520863 9.829879-1.599428 52.126194-17.968234 99.774401-45.184085 141.652184-80.912821 8.791224-7.577582 12.308327-19.628036 8.94165-30.758538-12.597923-40.678468-7.745405-83.20605 13.672394-119.773897 21.324678-36.625152 56.192813-62.030775 98.19237-71.547523 11.390421-2.592035 20.23588-11.633968 22.549575-23.106254 5.223978-27.184129 7.870248-54.358025 7.870248-80.770582C946.342316 487.171522 943.697069 459.965903 938.476161 432.79917zM728.572524 789.878798c-26.02677 20.157085-54.736649 36.553521-85.487 48.818869-36.682457-32.144094-83.60207-49.779753-132.792399-49.779753-48.926316 0-95.838765 17.635659-132.767839 49.786916-30.744211-12.262278-59.45716-28.655643-85.491093-48.812729 9.894348-47.441499 1.889023-96.449679-22.763446-138.627291-24.448832-41.966811-63.427588-73.339332-110.186542-88.840374-2.381234-16.343223-3.584642-32.758078-3.584642-48.869011 0-16.043395 1.203408-32.451086 3.584642-48.851615 46.612621-15.389502 85.584214-46.758953 110.186542-88.850607 24.523533-42.024116 32.525788-91.033319 22.74912-138.620128 26.0237-20.149922 54.735625-36.543288 85.494163-48.815799 36.821627 32.201399 83.73817 49.861618 132.778072 49.861618 49.194422 0 96.109941-17.635659 132.792399-49.779753 30.751375 12.269441 59.45716 28.662807 85.48086 48.812729-9.809413 47.63388-1.835811 96.634898 22.667256 138.620128 24.445762 41.966811 63.416332 73.343425 110.182448 88.850607 2.381234 16.386202 3.584642 32.801057 3.584642 48.940642 0.143263 15.443737-1.031493 31.797194-3.499707 48.701189-46.763047 15.504112-85.73771 46.873564-110.186542 88.836281C726.84416 693.189665 718.845998 742.190683 728.572524 789.878798z" />
              </Canvas>
            </Viewbox>
          </Button>
          <Button x:Name="StatisticsButton" Classes="window-control" ToolTip.Tip="每日统计"
                  Click="ShowStatistics_Click">
            <Grid Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Path Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Fill="{Binding #StatisticsButton.Foreground}"
                    Data="M917 872H107c-24.9 0-45 20.1-45 45s20.1 45 45 45h810c24.9 0 45-20.1 45-45s-20.1-45-45-45zM182 782c66.3 0 120-53.7 120-120V482c0-66.3-53.7-120-120-120S62 415.7 62 482v180c0 66.3 53.7 120 120 120z m-30-300c0-16.6 13.4-30 30-30s30 13.4 30 30v180c0 16.6-13.4 30-30 30s-30-13.4-30-30V482zM512 782c66.3 0 120-53.7 120-120V362c0-66.3-53.7-120-120-120s-120 53.7-120 120v300c0 66.3 53.7 120 120 120z m-30-420c0-16.6 13.4-30 30-30s30 13.4 30 30v300c0 16.6-13.4 30-30 30s-30-13.4-30-30V362zM842 62c-66.3 0-120 53.7-120 120v480c0 66.3 53.7 120 120 120s120-53.7 120-120V182c0-66.3-53.7-120-120-120z m30 600c0 16.6-13.4 30-30 30s-30-13.4-30-30V182c0-16.6 13.4-30 30-30s30 13.4 30 30v480z" />
            </Grid>
          </Button>
          <Button x:Name="MinimizeWindowButton" Classes="window-control" ToolTip.Tip="最小化"
                  Click="MinimizeWindow_Click">
            <Grid Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Path Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Fill="{Binding #MinimizeWindowButton.Foreground}"
                  Data="{StaticResource WindowMinimizeGeometry}" />
            </Grid>
          </Button>
          <Button x:Name="MaximizeButton" Classes="window-control" ToolTip.Tip="最大化"
                  Click="ToggleWindowState_Click">
            <Grid Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Path x:Name="MaximizeIcon" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Fill="{Binding #MaximizeButton.Foreground}"
                    Data="{StaticResource WindowMaximizeGeometry}" />
              <Path x:Name="RestoreIcon" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                    IsVisible="False"
                    Fill="{Binding #MaximizeButton.Foreground}"
                    Data="{StaticResource WindowRestoreGeometry}" />
            </Grid>
          </Button>
          <Button x:Name="CloseWindowButton" Classes="window-control close" ToolTip.Tip="关闭设置窗口"
                  Click="CloseWindow_Click">
            <Grid Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Path Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Fill="{Binding #CloseWindowButton.Foreground}"
                  Data="{StaticResource WindowCloseGeometry}" />
            </Grid>
          </Button>
        </StackPanel>
      </Grid>

      <Border Grid.Row="1" Padding="18,12,18,16">
        <Grid RowDefinitions="Auto,Auto,*" ColumnDefinitions="*,*" ColumnSpacing="14" RowSpacing="10">
          <Grid Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <Border Padding="10,7" CornerRadius="10"
                    Background="#FFFEFC" BorderBrush="#EAE2D9" BorderThickness="1">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <TextBlock x:Name="MonitorStateText" Text="监控中" FontSize="12" FontWeight="SemiBold"
                           Foreground="#9E4B2E" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText" Grid.Column="1" Text="设置翻译接口" FontSize="12"
                           Foreground="#756B63" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           ToolTip.Tip="运行状态和错误信息。" />
                <Button x:Name="CopyRecentLogsButton" Grid.Column="2" Classes="icon-button"
                        Width="26" Height="24" Click="CopyRecentLogs_Click" Cursor="Hand"
                        ToolTip.Tip="复制最近 7 天的日志（最多约 50 万字符）">
                  <Grid Width="16" Height="18">
                    <Path Stroke="{Binding #CopyRecentLogsButton.Foreground}" StrokeThickness="1.4"
                          Fill="Transparent"
                          Data="M7,5 L7,2 L15,2 L17,4 L17,13 L14,13 M4,5 L13,5 L15,7 L15,17 L4,17 Z" />
                  </Grid>
                </Button>
              </Grid>
            </Border>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <TextBlock Text="随系统启动" FontSize="13" Foreground="#684B3C" VerticalAlignment="Center" />
              <primitives:ToggleButton x:Name="StartupToggle" Classes="startup-toggle" Click="Startup_Click"
                                       Cursor="Hand" ToolTip.Tip="登录 Windows 后在后台启动 Cheems翻译。">
                <Border x:Name="StartupToggleTrack" Width="48" Height="28" CornerRadius="14"
                        Background="#E8DED4" BorderBrush="#D7C8BA" BorderThickness="1">
                  <Ellipse x:Name="StartupToggleThumb" Width="20" Height="20" Margin="3"
                           Fill="#FFFEFC" HorizontalAlignment="Left" VerticalAlignment="Center" />
                </Border>
              </primitives:ToggleButton>
              <TextBlock x:Name="StartupStateText" Text="关" Width="25" FontSize="12"
                         Foreground="#756B63" VerticalAlignment="Center" />
              <Button x:Name="AboutButton" Classes="icon-button" Width="30" Height="30"
                      Click="ShowAbout_Click" Cursor="Hand" ToolTip.Tip="关于 Cheems翻译">
                <Grid Width="18" Height="18">
                  <Path Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Fill="{Binding #AboutButton.Foreground}"
                        Data="M618 669.9c-89.6 77.4-62.5-58.4-58.4-77.4 4.1-19 62.4-135.8 19.7-155.4-42.8-19.7-174.5 77.4-174.5 77.4s-21.7 15.6-19.7 19.7c14.3 25.1 77.4-19.7 77.4-19.7s21.7-17.6 19.7 0c-19 76.5-32 154.3-38.7 232.8 9.5 51.6 91 29.9 154.8-38.7 63.8-68.5 19.7-38.7 19.7-38.7z m0 0 M566 378c24.2 1.3 47.3-10.4 60.5-30.7 13.2-20.3 14.7-46.1 3.7-67.8-11-21.6-32.6-35.8-56.9-37.1-24.2-1.3-47.3 10.4-60.5 30.7-13.2 20.3-14.7 46.1-3.7 67.8 11 21.6 32.7 35.8 56.9 37.1z m0 0 M884.8 853.9c87.3-93.3 135.9-216.4 135.8-344.2C1020.6 228.5 792.7 0.6 511.5 0.6 230.3 0.6 2.4 228.6 2.4 509.7c0 281.2 227.9 509.1 509.1 509.1h475.2c14.3 0.1 27.1-8.7 32.1-22 5-13.4 1.1-28.4-9.7-37.7L884.8 853.9zM511.5 951C267.8 951 70.2 753.4 70.2 509.7 70.2 266 267.7 68.5 511.4 68.5S952.6 266 952.6 509.7c0.4 122.1-50.3 238.8-139.8 321.8-7.1 7-10.7 16.8-9.9 26.7 0.8 9.9 5.9 19 14 24.9l80.8 67.9H511.5z m0 0" />
                </Grid>
              </Button>
            </StackPanel>
          </Grid>

          <Border Grid.Row="1" Grid.Column="0" Padding="14" CornerRadius="13"
                  Background="#FFFEFC" BorderBrush="#EAE2D9" BorderThickness="1" ClipToBounds="True">
            <Grid ClipToBounds="True">
              <TextBlock Text="翻译模型" FontSize="72" FontWeight="Bold" Foreground="#A95032"
                         Opacity="0.14" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                         Margin="0,0,14,10" IsHitTestVisible="False" />
              <TabControl x:Name="TranslationProviderTabs" Background="Transparent">
              <TabItem x:Name="AiProviderTab">
                <TabItem.Header>
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="AI 接入" />
                    <TextBlock x:Name="AiProviderCheckMark" Text="✓" Foreground="#38875B"
                               FontWeight="Bold" IsVisible="False" />
                  </StackPanel>
                </TabItem.Header>
                <StackPanel Spacing="8" Margin="2,8,2,2">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="OpenAI 兼容接口" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                    <ToggleSwitch x:Name="EnableAiProviderSwitch" Grid.Column="1" OnContent="启用" OffContent="停用"
                                  Checked="TranslationProviderSwitch_Changed" Unchecked="TranslationProviderSwitch_Changed" />
                  </Grid>
                  <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto"
                        ColumnSpacing="8" RowSpacing="8">
                    <TextBlock Text="翻译 AI" FontSize="12" FontWeight="SemiBold" Foreground="#655A52"
                               VerticalAlignment="Center" />
                    <ComboBox x:Name="TranslationAiProfileComboBox" Grid.Column="1"
                              HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="1" Text="解析 AI" FontSize="12" FontWeight="SemiBold"
                               Foreground="#655A52" VerticalAlignment="Center" />
                    <ComboBox x:Name="AnalysisAiProfileComboBox" Grid.Row="1" Grid.Column="1"
                              HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Grid.RowSpan="2" Content="管理 AI 接口" Classes="secondary"
                            VerticalAlignment="Center" Click="ManageAiProfiles_Click" />
                  </Grid>

                  <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto"
                        ColumnSpacing="8" RowSpacing="8">
                    <TextBlock Text="翻译提示词" FontSize="12" FontWeight="SemiBold" Foreground="#655A52"
                               VerticalAlignment="Center" />
                    <ComboBox x:Name="TranslationPromptProfileComboBox" Grid.Column="1"
                              HorizontalAlignment="Stretch" VerticalAlignment="Center"
                              ToolTip.Tip="选择翻译时使用的提示词配置。" />
                    <TextBlock Grid.Row="1" Text="解析提示词" FontSize="12" FontWeight="SemiBold"
                               Foreground="#655A52" VerticalAlignment="Center" />
                    <ComboBox x:Name="AnalysisPromptProfileComboBox" Grid.Row="1" Grid.Column="1"
                              HorizontalAlignment="Stretch" VerticalAlignment="Center"
                              ToolTip.Tip="选择原文译法分析时使用的提示词配置。" />
                    <TextBlock Grid.Row="2" Text="选词提示词" FontSize="12" FontWeight="SemiBold"
                               Foreground="#655A52" VerticalAlignment="Center" />
                    <ComboBox x:Name="SelectedTranslationTermPromptProfileComboBox" Grid.Row="2" Grid.Column="1"
                              HorizontalAlignment="Stretch" VerticalAlignment="Center"
                              ToolTip.Tip="选择浮窗选中译文词语后使用的专属提示词配置。" />
                    <Button Grid.Column="2" Grid.RowSpan="3" Content="管理提示词" Classes="secondary"
                            VerticalAlignment="Center" Click="ManagePromptProfiles_Click"
                            ToolTip.Tip="新增、编辑和删除翻译、原文解析或选词解析提示词。" />
                  </Grid>
                </StackPanel>
              </TabItem>

              <TabItem x:Name="HttpProviderTab">
                <TabItem.Header>
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="HTTP 接入" />
                    <TextBlock x:Name="HttpProviderCheckMark" Text="✓" Foreground="#38875B"
                               FontWeight="Bold" IsVisible="False" />
                  </StackPanel>
                </TabItem.Header>
                <StackPanel Spacing="8" Margin="2,8,2,2">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="HTTP 翻译接口" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                    <ToggleSwitch x:Name="EnableHttpProviderSwitch" Grid.Column="1" OnContent="启用" OffContent="停用"
                                  Checked="TranslationProviderSwitch_Changed" Unchecked="TranslationProviderSwitch_Changed" />
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <ComboBox x:Name="HttpTranslationProfileComboBox" HorizontalAlignment="Stretch"
                              VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="管理HTTP接口" Classes="secondary"
                            Click="ManageTranslationHttpProfiles_Click" />
                  </Grid>
                </StackPanel>
              </TabItem>
              </TabControl>
            </Grid>
          </Border>

          <Border Grid.Row="1" Grid.Column="1" Padding="14" CornerRadius="13"
                  Background="#FFFEFC" BorderBrush="#EAE2D9" BorderThickness="1" ClipToBounds="True">
            <Grid ClipToBounds="True" RowDefinitions="*,Auto" RowSpacing="4">
              <TextBlock Grid.RowSpan="2" Text="语音模型" FontSize="72" FontWeight="Bold" Foreground="#A95032"
                         Opacity="0.14" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                         Margin="0,0,14,10" IsHitTestVisible="False" />
              <TabControl x:Name="SpeechProviderTabs" Background="Transparent">
                <TabItem x:Name="SpeechAiProviderTab">
                  <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <TextBlock Text="AI 接入" />
                      <TextBlock x:Name="SpeechAiProviderCheckMark" Text="✓" Foreground="#38875B"
                                 FontWeight="Bold" IsVisible="False" />
                    </StackPanel>
                  </TabItem.Header>
                  <StackPanel Spacing="8" Margin="2,8,2,2">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="OpenAI 兼容接口" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                      <ToggleSwitch x:Name="EnableSpeechAiSwitch" Grid.Column="1" OnContent="启用" OffContent="停用"
                                    Checked="SpeechProviderSwitch_Changed" Unchecked="SpeechProviderSwitch_Changed" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <ComboBox x:Name="SpeechAiProfileComboBox" HorizontalAlignment="Stretch"
                                VerticalAlignment="Center" />
                      <Button Grid.Column="1" Content="管理 AI 接口" Classes="secondary"
                              Click="ManageSpeechAiProfiles_Click" />
                    </Grid>
                  </StackPanel>
                </TabItem>
                <TabItem x:Name="SpeechHttpProviderTab">
                  <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="5">
                      <TextBlock Text="HTTP 接入" />
                      <TextBlock x:Name="SpeechHttpProviderCheckMark" Text="✓" Foreground="#38875B"
                                 FontWeight="Bold" IsVisible="False" />
                    </StackPanel>
                  </TabItem.Header>
                  <StackPanel Spacing="8" Margin="2,8,2,2">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="通用 HTTP 语音接口" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                      <ToggleSwitch x:Name="EnableSpeechHttpSwitch" Grid.Column="1" OnContent="启用" OffContent="停用"
                                    Checked="SpeechProviderSwitch_Changed" Unchecked="SpeechProviderSwitch_Changed" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <ComboBox x:Name="HttpSpeechProfileComboBox" HorizontalAlignment="Stretch"
                                VerticalAlignment="Center" />
                      <Button Grid.Column="1" Content="管理HTTP接口" Classes="secondary"
                              Click="ManageSpeechHttpProfiles_Click" />
                    </Grid>
                  </StackPanel>
                </TabItem>
              </TabControl>
              <CheckBox x:Name="RealTimeSpeechCheckBox" Grid.Row="1" Content="实时语音"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"
                        Checked="RealTimeSpeech_Changed" Unchecked="RealTimeSpeech_Changed"
                        ToolTip.Tip="开启后，每次翻译完成都会自动播报最新一句；新播报会停止并替换上一条语音。" />
            </Grid>
          </Border>

          <Border Grid.Row="2" Grid.ColumnSpan="2" Padding="14" CornerRadius="13" Background="#FFFEFC"
                    BorderBrush="#EAE2D9" BorderThickness="1">
            <Grid RowDefinitions="Auto,*,Auto,*" RowSpacing="8">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="试译" FontSize="16" FontWeight="Bold" />
                  <TextBlock x:Name="TestProviderLabel" Grid.Column="1" Text="当前：AI 接入"
                             FontSize="11" Foreground="#756B63" VerticalAlignment="Center" />
                </Grid>
                <TextBox Grid.Row="1" x:Name="TestInputBox" Text="你好世界" AcceptsReturn="True" MinHeight="54"
                         TextWrapping="Wrap" Watermark="输入测试文本"
                         ToolTip.Tip="手动试译不会启动输入监控。" />
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                  <Button x:Name="TestButton" Content="翻译" HorizontalAlignment="Left" Click="TranslateTest_Click"
                          Width="60" Height="34" MinHeight="34" Padding="0"
                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                  <Button x:Name="TestAnalyzeButton" Content="解析" Classes="secondary"
                          HorizontalAlignment="Left" Click="AnalyzeTest_Click"
                          Width="60" Height="34" MinHeight="34" Padding="0"
                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                          ToolTip.Tip="使用解析 AI 分析上方输入内容。" />
                </StackPanel>
                <Border Grid.Row="3" Padding="10,8" CornerRadius="8" Background="#FBF7F2"
                        BorderBrush="#EFE5DA" BorderThickness="1">
                  <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                      <StackPanel x:Name="TestResultContent" MinHeight="22" Margin="0,0,30,0"
                                  Spacing="6" HorizontalAlignment="Stretch" />
                    </ScrollViewer>
                    <Button x:Name="TestSpeakButton" Classes="icon-button"
                            IsEnabled="False" Cursor="Hand" Click="TestSpeak_Click"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            ToolTip.Tip="播放试译结果">
                      <Grid Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Width="18" Height="18" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Fill="{Binding #TestSpeakButton.Foreground}"
                              Data="M283.221333 341.333333H256a85.333333 85.333333 0 0 0-85.333333 85.333334v170.666666a85.333333 85.333333 0 0 0 58.325333 80.981334v0.042666a42.666667 42.666667 0 0 1-26.965333 80.896l-1.194667-0.384A170.752 170.752 0 0 1 85.333333 597.333333v-170.666666a170.666667 170.666667 0 0 1 170.666667-170.666667h27.221333a42.666667 42.666667 0 0 0 27.306667-9.898667l92.202667-76.8C513.92 76.586667 682.666667 155.605333 682.666667 300.373333v423.253334c0 144.682667-168.746667 223.744-279.893334 131.114666L352.426667 812.8a42.624 42.624 0 0 1 25.557333-76.842667c11.093333 0 21.205333 4.266667 28.8 11.178667l0.042667-0.085333 50.517333 42.069333c55.552 46.336 139.946667 6.826667 139.946667-65.536V300.373333c0-72.362667-84.394667-111.872-139.946667-65.536l-92.245333 76.8A128 128 0 0 1 283.264 341.333333zM841.386667 269.056a42.666667 42.666667 0 0 0-61.44 59.221333C818.773333 368.64 853.333333 436.266667 853.333333 512s-34.56 143.36-73.386666 183.722667a42.666667 42.666667 0 0 0 61.44 59.221333C893.610667 700.672 938.666667 612.48 938.666667 512s-45.056-188.672-97.28-242.944z" />
                      </Grid>
                    </Button>
                  </Grid>
                </Border>
            </Grid>
          </Border>
        </Grid>
      </Border>
    </Grid>
  </Border>
    <Border Width="10" HorizontalAlignment="Left" Background="Transparent"
            Cursor="SizeWestEast" Tag="Left" PointerPressed="ResizeGrip_PointerPressed" />
    <Border Width="10" HorizontalAlignment="Right" Background="Transparent"
            Cursor="SizeWestEast" Tag="Right" PointerPressed="ResizeGrip_PointerPressed" />
    <Border Height="10" VerticalAlignment="Top" Background="Transparent"
            Cursor="SizeNorthSouth" Tag="Top" PointerPressed="ResizeGrip_PointerPressed" />
    <Border Height="10" VerticalAlignment="Bottom" Background="Transparent"
            Cursor="SizeNorthSouth" Tag="Bottom" PointerPressed="ResizeGrip_PointerPressed" />
    <Border Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Top"
            Background="Transparent" Cursor="TopLeftCorner" Tag="TopLeft"
            PointerPressed="ResizeGrip_PointerPressed" />
    <Border Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Top"
            Background="Transparent" Cursor="TopRightCorner" Tag="TopRight"
            PointerPressed="ResizeGrip_PointerPressed" />
    <Border Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Bottom"
            Background="Transparent" Cursor="BottomLeftCorner" Tag="BottomLeft"
            PointerPressed="ResizeGrip_PointerPressed" />
    <Border Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Bottom"
            Background="Transparent" Cursor="BottomRightCorner" Tag="BottomRight"
            PointerPressed="ResizeGrip_PointerPressed" />
  </Grid>
</Window>
